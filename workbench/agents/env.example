# One agent's own settings, read only by that agent when scripts/run-agents.sh starts it, after
# workbench/.env. Copy to workbench/agents/<name>.env, where <name> is the console script without
# `dd-` (standards.env for dd-standards). These files are not committed.
#
# A model key belongs here, never in workbench/.env, so that no other agent is given it
# (ADR-0026). An agent set to call a model stops at start-up if it has no key.

# --- standards.env -------------------------------------------------------------------------
DD_STANDARDS_EXPLAINER=anthropic
# The model identifier is the deployment's choice; the agent has a default.
# DD_MODEL_ID=
ANTHROPIC_API_KEY=

# --- orchestrator.env ----------------------------------------------------------------------
# dd-orchestrator always calls a model, so it has no start-up without a key.
ANTHROPIC_API_KEY=
# The defaults: a small model, at high effort, with the last 20 turns and up to four
# delegations a turn.
# DD_MODEL_ID=claude-haiku-5-5
# DD_ORCHESTRATOR_EFFORT=high
# DD_ORCHESTRATOR_HISTORY=20
# DD_ORCHESTRATOR_MAX_DELEGATIONS=4
