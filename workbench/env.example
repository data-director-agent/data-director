# Copy to .env (or export) as needed. Nothing here is required for `uv run pytest`.
# Harness variables are read by settings.py. Each agent is a separate service and reads its own
# DD_<AGENT>_* in its own process, so set those where the agent runs.

# --- Harness --------------------------------------------------------------------------------
# Where runs are written (envelopes, spans, crates). Default: ./runs
DD_RUNS_DIR=runs
# Write a Process Run Crate per invocation (1) or not (0).
DD_WRITE_CRATE=1
# The institutional profile this deployment applies to every invocation (ADR-0017). A request
# cannot name one. Default: ./profiles/default.yaml
# DD_PROFILE=profiles/default.yaml
# Where the agents are: a YAML list of base URLs (ADR-0011). Default: ./agents.yaml
# DD_AGENTS_CONFIG=agents.yaml
# The address delegation agents such as director.stub call the workbench back on (ADR-0012).
# `workbench serve` uses its own host and port when this is unset.
# DD_WORKBENCH_URL=http://127.0.0.1:8000

# --- hello.world, quality.reviewer, fact.checker, stub.abstain -----------------------------
# No configuration: offline, deterministic, no model.

# --- r3.standards-advisor (read by agents/r3/src/dd_agent_r3/factory.py) ---------------------
# R3 retrieval backend: snapshot (default; agents/r3/data/fairsharing/snapshot.jsonl) or live.
DD_R3_RETRIEVAL=snapshot
# FAIRsharing account, needed only for live *search* (record fetch is public).
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=
# R3 explainer: template (default, deterministic, no key) or anthropic.
DD_R3_EXPLAINER=template
DD_MODEL_ID=claude-opus-5
# ANTHROPIC_API_KEY is read by the Anthropic SDK itself (or use `ant auth login`).
ANTHROPIC_API_KEY=
# DD_SNAPSHOT_PATH=agents/r3/data/fairsharing/snapshot.jsonl
