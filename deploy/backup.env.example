# backup.sh's settings (deploy/README.md, "Backups"), in /etc/data-director/backup.env.

# Where backups are written. The directory is root's alone: a backup holds every secret.
DD_BACKUP_DIR=/var/backups/data-director

# How many days a backup is kept. A person's data deleted from the stores stays in the backups for
# up to this long, so it is a data-protection decision for the deployment, not a default to leave
# unconsidered: TODO(#156).
DD_BACKUP_KEEP_DAYS=30
