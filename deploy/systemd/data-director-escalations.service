# Send each escalation to a data steward that nobody has taken within the profile's
# `stewardship.reroute_after` to its team again, and email the team where the profile names its
# address (docs/specs/stewardship.md, invariant 13). It runs as the app's user, over the app's
# project store and settings, and does nothing where the profile sets no `reroute_after`. Run it by
# hand with `sudo systemctl start data-director-escalations.service`.
[Unit]
Description=Send unanswered Data Director escalations to their steward team again
Documentation=https://github.com/data-director-agent/data-director/blob/main/docs/guide/operations/configuration.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=datadirector
Group=datadirector
WorkingDirectory=/opt/data-director/current
Environment=DD_PROJECTS_DIR=/var/lib/data-director/projects
# DD_PROFILE, and DD_SMTP_URL, DD_MAIL_FROM and DD_APP_PUBLIC_URL where teams are emailed: the
# app's settings. A mail server that asks for a password takes it as a credential, in a drop-in
# beside the app's (docs/guide/operations/configuration.md, "Notifications").
EnvironmentFile=/etc/data-director/app.env
ExecStart=/opt/data-director/current/.venv/bin/dd-harness escalations sweep
SyslogIdentifier=data-director-escalations
TimeoutStartSec=15min

# Hardening: it writes only the project store.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/data-director/projects
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027
