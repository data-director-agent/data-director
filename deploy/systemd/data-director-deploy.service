# One pass of the deployment: deploy the tip of the branch if CI passed on it (deploy.sh).
# It runs the deploy.sh of the release now live, so a change to deploy.sh takes effect from the
# deployment after the one that ships it. Run it by hand with
# `sudo systemctl start data-director-deploy.service`.
[Unit]
Description=Deploy the latest Data Director commit that passed CI
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=datadirector
Group=datadirector
EnvironmentFile=-/etc/data-director/deploy.env
# uv installs Python here, readable by every service's user, not in the deploy user's home, which
# the model broker's user cannot enter (deploy/install.sh).
Environment=UV_PYTHON_INSTALL_DIR=/opt/data-director/python
ExecStart=/opt/data-director/current/deploy/deploy.sh
# A first build downloads Python, the locked packages and the shell's npm packages.
TimeoutStartSec=30min
# The build shares the VM with the people using it: on a 3.8 GiB VM an unbounded one pushed the
# stack into swap for twenty minutes (#1616). It gets the least CPU and disk, and a memory budget:
# past MemoryHigh the kernel slows it, past MemoryMax it is killed, leaving no .built, so the next
# pass starts again. NODE_OPTIONS keeps each Node build's heap inside that budget.
Nice=19
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
MemoryHigh=1G
MemoryMax=1500M
Environment=NODE_OPTIONS=--max-old-space-size=768
SyslogIdentifier=data-director-deploy
# deploy.sh restarts the services by writing /opt/data-director/restart-requested, which
# data-director-restart.path watches. It runs no command as root.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
UMask=0022
