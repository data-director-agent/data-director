# The Data Director app and the agents it reaches over A2A. `systemctl restart
# data-director.target` restarts them all, which is what deploy.sh does after a release. Which
# agents it starts is not written here: `data-director apply` writes a Wants= line for each agent
# /etc/data-director/deployment.yaml runs, in data-director.target.d/agents.conf.
[Unit]
Description=Data Director (app and agents)
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
Wants=data-director-app.service

[Install]
WantedBy=multi-user.target
