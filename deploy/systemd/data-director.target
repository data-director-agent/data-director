# The Data Director app and the agents it reaches over A2A. `systemctl restart
# data-director.target` restarts them all, which is what deploy.sh does after a release.
[Unit]
Description=Data Director (app and agents)
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
Wants=data-director-app.service
Wants=data-director-agent@example-hello.service
Wants=data-director-agent@advisor-quality.service
Wants=data-director-agent@advisor-standards.service
Wants=data-director-agent@advisor-policy.service
Wants=data-director-agent@advisor-repository.service
Wants=data-director-agent@advisor-ethics.service
Wants=data-director-agent@advisor-files.service
Wants=data-director-agent@advisor-dmp.service
Wants=data-director-agent@advisor-metadata.service
Wants=data-director-agent@advisor-documentation.service
Wants=data-director-agent@advisor-rights.service
Wants=data-director-agent@advisor-linking.service
Wants=data-director-agent@advisor-fairness.service
Wants=data-director-agent@orchestrator-stub.service

[Install]
WantedBy=multi-user.target
