# The Data Director app (app/README.md). It reads the agents' cards once at start-up, so it
# starts after them and waits until their ports answer. NGINX is its only way in from outside
# the host (deploy/nginx/data-director.conf).
[Unit]
Description=Data Director app
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
After=network-online.target data-director-agent@hello.service data-director-agent@quality.service data-director-agent@standards.service data-director-agent@director.service
Wants=network-online.target
PartOf=data-director.target

[Service]
Type=exec
User=datadirector
Group=datadirector
WorkingDirectory=/opt/data-director/current
Environment=DD_APP_HOST=127.0.0.1
Environment=DD_APP_PORT=7860
Environment=DD_RUNS_DIR=/var/lib/data-director/runs
# The agents' ports to wait for.
Environment="DD_WAIT_PORTS=8101 8102 8105 8106"
# DD_PRINCIPAL_ID and DD_PRINCIPAL_NAME (required), and any override of the above.
EnvironmentFile=/etc/data-director/app.env
ExecStartPre=/opt/data-director/current/deploy/wait-for-ports.sh 60 $DD_WAIT_PORTS
ExecStart=/opt/data-director/current/.venv/bin/data-director
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
SyslogIdentifier=data-director

# Hardening: the app writes only its run store.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/data-director/runs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=data-director.target
