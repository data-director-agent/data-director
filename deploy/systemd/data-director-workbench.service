# The Data Director Workbench (workbench/README.md): the development way in to the harness, for
# admins only. It is a service of its own beside the app, sharing nothing with it but the agents
# and the ORCID client. It starts after the agents and waits for their ports as the app does:
# `data-director apply` writes the After= lines and DD_WAIT_PORTS in
# data-director-workbench.service.d/agents.conf. NGINX serves it on port 8443
# (deploy/nginx/data-director.conf).
#
# It runs under the instance's own profile, which `data-director apply` writes from
# deployment.yaml. install.sh enables it only once that profile names an administrator: a workbench
# that signs people in admits only the administrators the profile names, and does not start
# without one.
[Unit]
Description=Data Director Workbench
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target
PartOf=data-director.target
# Give up after ten starts in five minutes. systemd's default (five in ten seconds) never trips on
# RestartSec=5 plus a slow start, so a unit that cannot start would loop for ever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
User=datadirector
Group=datadirector
WorkingDirectory=/opt/data-director/current
# The workbench's own run store, apart from the app's.
Environment=DD_RUNS_DIR=/var/lib/data-director/workbench-runs
# The instance's profile, as the app's: its agents, its policy and its administrators.
Environment=DD_PROFILE=/etc/data-director/profile.yaml
# Who is signed in to the workbench, apart from the app's, kept across a restart (#900).
Environment=DD_SESSIONS_FILE=/var/lib/data-director/workbench-sessions/sessions.db
# The ORCID client's secret. The workbench uses the app's client, registered with a second redirect
# URI; systemd hands each unit its own copy of the credential.
LoadCredential=orcid-client-secret:/etc/data-director/credentials/app/orcid-client-secret
Environment=DD_OIDC_CLIENT_SECRET_FILE=orcid-client-secret
# DD_OIDC_ISSUER, DD_OIDC_CLIENT_ID and DD_WORKBENCH_PUBLIC_URL.
EnvironmentFile=/etc/data-director/workbench.env
ExecStartPre=/opt/data-director/current/deploy/wait-for-ports.sh 60 $DD_WAIT_PORTS
ExecStart=/opt/data-director/current/.venv/bin/workbench serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# A configuration error (dd_sdk.serve.EXIT_CONFIG): stopping again is all a restart would do.
RestartPreventExitStatus=2
TimeoutStartSec=90
TimeoutStopSec=30
SyslogIdentifier=data-director-workbench

# Hardening: the workbench writes only its run store and its sessions.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/data-director/workbench-runs /var/lib/data-director/workbench-sessions
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=data-director.target
