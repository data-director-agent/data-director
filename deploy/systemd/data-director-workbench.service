# The Data Director Workbench (workbench/README.md): the development way in to the harness, for
# admins only. It is a service of its own beside the app, sharing nothing with it but the agents
# and the ORCID client. NGINX serves it on port 8443 (deploy/nginx/data-director.conf).
#
# install.sh enables it only once DD_WORKBENCH_ADMINS is set in /etc/data-director/workbench.env:
# a workbench that signs people in admits only the ORCID iDs listed there, and does not start
# without them.
[Unit]
Description=Data Director Workbench
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
After=network-online.target
After=data-director-agent@example-hello.service
After=data-director-agent@advisor-quality.service
After=data-director-agent@advisor-standards.service
After=data-director-agent@advisor-policy.service
After=data-director-agent@advisor-repository.service
After=data-director-agent@advisor-ethics.service
After=data-director-agent@advisor-files.service
After=data-director-agent@advisor-dmp.service
After=data-director-agent@advisor-metadata.service
After=data-director-agent@advisor-documentation.service
After=data-director-agent@advisor-rights.service
After=data-director-agent@advisor-linking.service
After=data-director-agent@advisor-fairness.service
After=data-director-agent@orchestrator-stub.service
Wants=network-online.target
PartOf=data-director.target

[Service]
Type=exec
User=datadirector
Group=datadirector
WorkingDirectory=/opt/data-director/current
# The workbench's own run store, apart from the app's.
Environment=DD_RUNS_DIR=/var/lib/data-director/workbench-runs
# The agents' ports to wait for (the same as the app's).
Environment="DD_WAIT_PORTS=8101 8102 8105 8108 8109 8111 8110 8112 8113 8114 8115 8116 8117 8106"
# The ORCID client's secret. The workbench uses the app's client, registered with a second redirect
# URI; systemd hands each unit its own copy of the credential.
LoadCredential=orcid-client-secret:/etc/data-director/credentials/app/orcid-client-secret
Environment=DD_OIDC_CLIENT_SECRET_FILE=orcid-client-secret
# DD_OIDC_ISSUER, DD_OIDC_CLIENT_ID, DD_WORKBENCH_PUBLIC_URL and DD_WORKBENCH_ADMINS (required).
EnvironmentFile=/etc/data-director/workbench.env
ExecStartPre=/opt/data-director/current/deploy/wait-for-ports.sh 60 $DD_WAIT_PORTS
ExecStart=/opt/data-director/current/.venv/bin/workbench serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
SyslogIdentifier=data-director-workbench

# Hardening: the workbench writes only its run store.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/data-director/workbench-runs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=data-director.target
