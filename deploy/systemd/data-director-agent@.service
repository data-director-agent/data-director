# One agent service, `dd-<instance>`, on the port deploy/agents/<instance>.env names. Each
# listens on loopback only: until callers are authenticated (#17), no agent port leaves the
# host (ADR-0011).
[Unit]
Description=Data Director agent dd-%i
Documentation=https://github.com/data-director-agent/data-director/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target
PartOf=data-director.target

[Service]
Type=exec
User=datadirector
Group=datadirector
WorkingDirectory=/opt/data-director/current
EnvironmentFile=/opt/data-director/current/deploy/agents/%i.env
# The agents' own DD_<AGENT>_* settings, such as DD_STANDARDS_RETRIEVAL or a model id.
EnvironmentFile=-/etc/data-director/agents.env
ExecStart=/opt/data-director/current/.venv/bin/dd-%i serve --host 127.0.0.1 --port ${PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SyslogIdentifier=dd-%i

# Hardening: the agents read the release and write nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=data-director.target
