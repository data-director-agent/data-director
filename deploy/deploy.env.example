# Settings for deploy.sh. install.sh copies this to /etc/data-director/deploy.env once; edit that
# copy. Each line shows the default.

# Where to fetch from, and which branch to keep deployed.
# DD_DEPLOY_REPO=https://github.com/data-director-agent/data-director.git
# DD_DEPLOY_BRANCH=main

# The check run that must have succeeded on a commit before it is deployed (.github/workflows/ci.yml).
# DD_DEPLOY_CHECK=CI passed

# How many commits back from the branch's tip a pass looks for one that passed CI. Each commit it
# looks at, newest first until one has passed, is one request to the GitHub API.
# DD_DEPLOY_DEPTH=10

# How many release directories to keep for rollback, the live one included.
# DD_DEPLOY_KEEP=3

# A build waits while less memory than this many megabytes is available, so it does not push a busy
# VM into swap; the pass records nothing and the next one tries again. 0 never waits. On a VM that
# always sits below the figure nothing would deploy, so lower it or set 0.
# DD_DEPLOY_MIN_MEMORY_MB=600

# A built release waits for the turns the app is running to end before it restarts the app. After
# this many minutes it restarts anyway, so that a deployment is not held back for ever.
# DD_DEPLOY_BUSY_LIMIT_MIN=120

# Only for a private repository, or if the VM shares its address with much other GitHub API use.
# A fine-grained token with read access to checks is enough.
# GITHUB_TOKEN=
