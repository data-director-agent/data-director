# Settings for deploy.sh. install.sh copies this to /etc/data-director/deploy.env once; edit that
# copy. Each line shows the default.

# Where to fetch from, and which branch to keep deployed.
# DD_DEPLOY_REPO=https://github.com/data-director-agent/data-director.git
# DD_DEPLOY_BRANCH=main

# The check run that must have succeeded on a commit before it is deployed (.github/workflows/ci.yml).
# DD_DEPLOY_CHECK=CI passed

# How many release directories to keep for rollback, the live one included.
# DD_DEPLOY_KEEP=3

# Only for a private repository, or if the VM shares its address with much other GitHub API use.
# A fine-grained token with read access to checks is enough.
# GITHUB_TOKEN=
