# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  echo "sk-$(openssl rand -hex 32)"

# --- Gateway secrets -------------------------------------------------------
# Admin key for the proxy and password for the admin UI (user: admin).
LITELLM_MASTER_KEY=sk-change-me
# Encrypts provider credentials stored in the DB. Do NOT change after adding models.
LITELLM_SALT_KEY=sk-change-me-too
POSTGRES_PASSWORD=change-me

# --- Provider keys (leave blank for providers you don't use) ----------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama running on the Docker host (default port 11434).
OLLAMA_API_BASE=http://host.docker.internal:11434

# --- Optional: Langfuse tracing (uncomment success_callback in config.yaml) --
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
