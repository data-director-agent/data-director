{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha",
  "group-pull-request-title-pattern": "chore(main): release ${branch}",
  "include-v-in-tag": true,
  "packages": {
    "sdk": {
      "component": "sdk",
      "release-type": "python",
      "exclude-paths": [
        "sdk/tests"
      ]
    },
    "harness": {
      "component": "harness",
      "release-type": "python",
      "exclude-paths": [
        "harness/tests"
      ]
    },
    "workbench": {
      "component": "workbench",
      "release-type": "python",
      "exclude-paths": [
        "workbench/tests",
        "workbench/browser_tests"
      ]
    },
    "app": {
      "component": "app",
      "release-type": "python",
      "extra-files": [
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "app/tests"
      ]
    },
    "agents/orchestrator-stub": {
      "component": "agent-orchestrator-stub",
      "release-type": "python",
      "exclude-paths": [
        "agents/orchestrator-stub/tests"
      ]
    },
    "agents/orchestrator-model": {
      "component": "agent-orchestrator-model",
      "release-type": "python",
      "exclude-paths": [
        "agents/orchestrator-model/tests"
      ]
    },
    "agents/example-hello": {
      "component": "agent-example-hello",
      "release-type": "python",
      "exclude-paths": [
        "agents/example-hello/tests"
      ]
    },
    "agents/advisor-quality": {
      "component": "agent-advisor-quality",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-quality/tests"
      ]
    },
    "agents/advisor-standards": {
      "component": "agent-advisor-standards",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-standards/tests"
      ]
    },
    "agents/advisor-repository": {
      "component": "agent-advisor-repository",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-repository/tests"
      ]
    },
    "agents/advisor-policy": {
      "component": "agent-advisor-policy",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-policy/tests"
      ]
    },
    "inventory": {
      "component": "inventory",
      "release-type": "python",
      "exclude-paths": [
        "inventory/tests"
      ]
    }
  }
}
