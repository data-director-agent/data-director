{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha",
  "group-pull-request-title-pattern": "chore(main): release ${branch}",
  "include-v-in-tag": true,
  "packages": {
    "sdk": {
      "component": "sdk",
      "release-type": "python",
      "exclude-paths": [
        "sdk/tests"
      ]
    },
    "harness": {
      "component": "harness",
      "release-type": "python",
      "exclude-paths": [
        "harness/tests"
      ]
    },
    "workbench": {
      "component": "workbench",
      "release-type": "python",
      "exclude-paths": [
        "workbench/tests",
        "workbench/browser_tests"
      ]
    },
    "app": {
      "component": "app",
      "release-type": "python",
      "extra-files": [
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "app/tests"
      ]
    },
    "agents/director": {
      "component": "agent-director",
      "release-type": "python",
      "exclude-paths": [
        "agents/director/tests"
      ]
    },
    "agents/orchestrator": {
      "component": "agent-orchestrator",
      "release-type": "python",
      "exclude-paths": [
        "agents/orchestrator/tests"
      ]
    },
    "agents/hello": {
      "component": "agent-hello",
      "release-type": "python",
      "exclude-paths": [
        "agents/hello/tests"
      ]
    },
    "agents/quality": {
      "component": "agent-quality",
      "release-type": "python",
      "exclude-paths": [
        "agents/quality/tests"
      ]
    },
    "agents/standards": {
      "component": "agent-standards",
      "release-type": "python",
      "exclude-paths": [
        "agents/standards/tests"
      ]
    },
    "agents/repository": {
      "component": "agent-repository",
      "release-type": "python",
      "exclude-paths": [
        "agents/repository/tests"
      ]
    }
  }
}
