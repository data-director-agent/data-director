{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore(main): release ${branch}",
  "include-v-in-tag": true,
  "packages": {
    "sdk": {
      "component": "sdk",
      "release-type": "python"
    },
    "harness": {
      "component": "harness",
      "release-type": "python"
    },
    "workbench": {
      "component": "workbench",
      "release-type": "python"
    },
    "app": {
      "component": "app",
      "release-type": "python",
      "extra-files": [
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "agents/director": {
      "component": "agent-director",
      "release-type": "python"
    },
    "agents/hello": {
      "component": "agent-hello",
      "release-type": "python"
    },
    "agents/quality": {
      "component": "agent-quality",
      "release-type": "python"
    },
    "agents/standards": {
      "component": "agent-standards",
      "release-type": "python"
    }
  }
}
