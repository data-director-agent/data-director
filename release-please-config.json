{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "alpha",
  "group-pull-request-title-pattern": "chore(main): release ${branch}",
  "include-v-in-tag": true,
  "packages": {
    "sdk": {
      "component": "sdk",
      "release-type": "python",
      "exclude-paths": [
        "sdk/tests",
        "sdk/browser"
      ]
    },
    "harness": {
      "component": "harness",
      "release-type": "python",
      "exclude-paths": [
        "harness/tests"
      ]
    },
    "workbench": {
      "component": "workbench",
      "release-type": "python",
      "exclude-paths": [
        "workbench/tests",
        "workbench/browser_tests"
      ]
    },
    "app": {
      "component": "app",
      "release-type": "python",
      "extra-files": [
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": [
        "app/tests"
      ]
    },
    "admin": {
      "component": "admin",
      "release-type": "python",
      "exclude-paths": [
        "admin/tests"
      ]
    },
    "broker": {
      "component": "model-broker",
      "release-type": "python",
      "exclude-paths": [
        "broker/tests"
      ]
    },
    "deposit-broker": {
      "component": "deposit-broker",
      "release-type": "python",
      "exclude-paths": [
        "deposit-broker/tests"
      ]
    },
    "agents/orchestrator-stub": {
      "component": "agent-orchestrator-stub",
      "release-type": "python",
      "exclude-paths": [
        "agents/orchestrator-stub/tests"
      ]
    },
    "agents/orchestrator-model": {
      "component": "agent-orchestrator-model",
      "release-type": "python",
      "exclude-paths": [
        "agents/orchestrator-model/tests"
      ]
    },
    "agents/example-hello": {
      "component": "agent-example-hello",
      "release-type": "python",
      "exclude-paths": [
        "agents/example-hello/tests"
      ]
    },
    "agents/advisor-quality": {
      "component": "agent-advisor-quality",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-quality/tests"
      ]
    },
    "agents/advisor-standards": {
      "component": "agent-advisor-standards",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-standards/tests"
      ]
    },
    "agents/advisor-repository": {
      "component": "agent-advisor-repository",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-repository/tests"
      ]
    },
    "agents/advisor-policy": {
      "component": "agent-advisor-policy",
      "release-type": "python",
      "exclude-paths": [
        "agents/advisor-policy/tests"
      ]
    },
    "inventory": {
      "component": "inventory",
      "release-type": "python",
      "exclude-paths": [
        "inventory/tests",
        "inventory/browser"
      ]
    },
    "mcp-pid": {
      "component": "mcp-pid",
      "release-type": "python",
      "exclude-paths": [
        "mcp-pid/tests"
      ]
    },
    "mcp-fairsharing": {
      "component": "mcp-fairsharing",
      "release-type": "python",
      "exclude-paths": [
        "mcp-fairsharing/tests"
      ]
    },
    "mcp-spdx": {
      "component": "mcp-spdx",
      "release-type": "python",
      "exclude-paths": [
        "mcp-spdx/tests"
      ]
    },
    "mcp-subjects": {
      "component": "mcp-subjects",
      "release-type": "python",
      "exclude-paths": [
        "mcp-subjects/tests"
      ]
    },
    "mcp-doaj": {
      "component": "mcp-doaj",
      "release-type": "python",
      "exclude-paths": [
        "mcp-doaj/tests"
      ]
    },
    "units": {
      "component": "units",
      "release-type": "python",
      "exclude-paths": [
        "units/tests"
      ]
    },
    "registry-cache": {
      "component": "registry-cache",
      "release-type": "python",
      "exclude-paths": [
        "registry-cache/tests"
      ]
    },
    "subjects": {
      "component": "subjects",
      "release-type": "python",
      "exclude-paths": [
        "subjects/tests"
      ]
    },
    "dmp-template": {
      "component": "dmp-template",
      "release-type": "python",
      "exclude-paths": [
        "dmp-template/tests"
      ]
    },
    "metadata-records": {
      "component": "metadata-records",
      "release-type": "python",
      "exclude-paths": [
        "metadata-records/tests"
      ]
    }
  }
}
