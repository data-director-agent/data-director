@prefix doubles: <https://w3id.org/data-director/harness/doubles/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

doubles:ProbeRecord a sh:NodeShape ;
    rdfs:comment "A metadata record for an input_only or none double to read." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Who made the thing the record describes." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path doubles:creators ],
        [ sh:datatype xsd:string ;
            sh:description "The record's licence." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path doubles:licence ],
        [ sh:datatype xsd:string ;
            sh:description "The record's identifier." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path doubles:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:datatype xsd:string ;
            sh:description "A title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path doubles:title ],
        [ sh:datatype xsd:string ;
            sh:description "Keywords." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path doubles:keywords ] ;
    sh:targetClass doubles:ProbeRecord .

