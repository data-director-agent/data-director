{
  "name": "@data-director/agent-view",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "Inspecting Data Director A2A agent cards and their payloads in TypeScript and React (README.md)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
