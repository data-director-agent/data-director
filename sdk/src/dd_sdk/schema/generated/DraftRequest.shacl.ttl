@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dd: <https://w3id.org/data-director/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dd:DraftRequest a sh:NodeShape ;
    rdfs:comment "What a drafter is asked for: a project document of one kind, drafted from the project's facts (docs/specs/projects.md). Every agent that returns a Document accepts it, so an agent that drafts a document can replace another without its caller changing. The project's facts are the inventory, the requirements of the repository chosen, the metadata record a person approved last and, to regenerate a document, its current version with any decision on it. In a project, the conductor puts the inventory, the requirements and the metadata record in from the project, replacing whatever the caller sent, so a caller leaves them out; outside a project, the caller sends them. In a project the conductor also fills current_version, the latest version of the project's document of that kind, or of the document redraft_document names, so a redraft is that document's next version. The answers a person recorded to the current version's questions are filled in by the conductor in the same way (docs/specs/drafting.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dd:CurrentVersion ;
            sh:description "The document's latest version, when the drafter is to regenerate it. Absent for a new document." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dd:current_version ],
        [ sh:description "The kind of document to draft." ;
            sh:in ( "metadata_record" "readme" "data_dictionary" "dmp" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dd:document_kind ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:schema_class ],
        [ sh:class dd:RepositoryRequirements ;
            sh:description "The requirements of the repository chosen last. In a project the conductor fills it; a caller leaves it out." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dd:requirements ],
        [ sh:class dd:ApprovedMetadataRecord ;
            sh:description "The project's metadata record, the version a person approved last, if any has been. In a project the conductor fills it; a caller leaves it out." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dd:metadata_record ],
        [ sh:datatype xsd:string ;
            sh:description "The project document to redraft, by its document_id, where the project holds more than one of the kind asked for. Without it the conductor gives the latest. In a project the conductor refuses a document that is not the project's or is of another kind; outside a project it is removed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dd:redraft_document ;
            sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ],
        [ sh:class dd:DraftAnswer ;
            sh:description "The answers a person recorded to the current version's questions. In a project the conductor fills them; a caller leaves them out." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dd:draft_answers ],
        [ sh:class dd:FileInventory ;
            sh:description "The project's inventory, the latest added. In a project the conductor fills it; a caller leaves it out." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dd:inventory ] ;
    sh:targetClass dd:DraftRequest .

dd:ApprovedMetadataRecord a sh:NodeShape ;
    rdfs:comment "The project's metadata record as a person approved it: the version named by the last approval of a metadata_record document in the project (docs/specs/projects.md). A drafter treats what it holds as supplied, given by a person (docs/specs/drafting.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The schema or profile document_text follows, such as a repository's metadata schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:class dd:DocumentVersionRef ;
            sh:description "The version, by its document and number." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dd:version_ref ],
        [ sh:datatype xsd:string ;
            sh:description "The media type of document_text, such as text/markdown or application/json." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:format ],
        [ sh:datatype xsd:string ;
            sh:description "The content of the document, as text; a structured record is serialised." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:document_text ] ;
    sh:targetClass dd:ApprovedMetadataRecord .

dd:CurrentVersion a sh:NodeShape ;
    rdfs:comment "The version of a project document that a drafter is to regenerate: the document's latest, its text, and its state with the reason a person gave for any decision on it (ADR-0036 decision 7). A drafter that regenerates it names version_ref in its payload's revises." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The reason the person gave for their decision, in their words. Present for a rejection, and for an approval only if they gave one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:decision_reason ],
        [ sh:datatype xsd:string ;
            sh:description "The media type of document_text, such as text/markdown or application/json." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:format ],
        [ sh:description "Whether a person has approved or rejected the version, or not yet decided." ;
            sh:in ( "proposed" "approved" "rejected" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path dd:version_state ],
        [ sh:class dd:DocumentVersionRef ;
            sh:description "The version, by its document and number." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dd:version_ref ],
        [ sh:datatype xsd:string ;
            sh:description "A short name a person can tell documents apart by, such as README for raw/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:datatype xsd:string ;
            sh:description "The content of the document, as text; a structured record is serialised." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:document_text ] ;
    sh:targetClass dd:CurrentVersion .

dd:DraftAnswer a sh:NodeShape ;
    rdfs:comment "A person's answer to one question a version of the document asked (DocumentQuestion). The drafter places answer_text, as given, in the gap or cell the question names and marks it supplied (docs/specs/drafting.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The question_id of the question answered." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:answered_question ;
            sh:pattern "^q-[0-9a-f]{16}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The answer as the person gave it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:answer_text ] ;
    sh:targetClass dd:DraftAnswer .

dd:FileInventory a sh:NodeShape ;
    rdfs:comment "The facts about a dataset's files that the project holds in place of the files (docs/specs/projects.md): for each file its path, size, digest and format, and for a table its fields. Made by a command run where the data live; it never contains a file's content. advisor.files reads it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The version of the command that made the inventory." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:inventory_tool_version ],
        [ sh:datatype xsd:string ;
            sh:description "What the inventory left out or could not do, such as files it skipped." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dd:inventory_limitations ],
        [ sh:datatype xsd:string ;
            sh:description "What identified the formats, such as fido 1.6.1 with PRONOM signatures v109, or that only file extensions were used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:inventory_identified_with ],
        [ sh:datatype xsd:string ;
            sh:description "The command that made the inventory, such as dd-inventory." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:schema_class ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the inventory was made." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path prov:generatedAtTime ],
        [ sh:class dd:InventoryFile ;
            sh:description "Every file under the dataset's root folder that the command read, sorted by path." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dd:inventory_files ] ;
    sh:targetClass dd:FileInventory .

dd:InventoryFile a sh:NodeShape ;
    rdfs:comment "One file of a dataset, as the inventory command found it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Every PRONOM unique identifier (PUID) the file matched, such as fmt/95 or x-fmt/18. More than one means the identification is ambiguous; none means the format is unknown." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:file_pronom_ids ],
        [ sh:class dd:TableField ;
            sh:description "For a table, its fields as a Frictionless Table Schema inferred from a sample of rows." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dd:file_fields ],
        [ sh:description "How the PRONOM identifiers were arrived at." ;
            sh:in ( "signature" "container" "extension" "none" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dd:file_identified_by ],
        [ sh:datatype xsd:integer ;
            sh:description "The file's size in bytes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcat:byteSize ],
        [ sh:datatype xsd:string ;
            sh:description "The SHA-256 digest of the file's bytes, in lowercase hex, by which the file deposited can be shown to be the file described." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path spdx:checksumValue ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The file's media type (MIME type), when it could be told." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcat:mediaType ],
        [ sh:datatype xsd:string ;
            sh:description "The file's path relative to the dataset's root folder, with forward slashes. Never an absolute path, which would say where the data live." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:file_path ;
            sh:pattern "^[^/]" ] ;
    sh:targetClass dd:InventoryFile .

dd:RepositoryRequirements a sh:NodeShape ;
    rdfs:comment "The requirements of the repository a researcher chose: its standard's set with the repository's override, if there is one, merged on top (ADR-0038 decision 2). The harness makes it when the choice is recorded, keeps it among the project's blobs, gives it to the drafters and checks the project against it. Not a set of the deployment's configuration, so it has no requirement_set_id of its own; requirement_sets names the sets it was merged from." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "An override only: the largest deposit the repository accepts, in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dd:max_item_size ],
        [ sh:description "Where the chosen repository is, taken from its override's url; absent when the deployment has no override for it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dd:repository_url ],
        [ sh:datatype xsd:string ;
            sh:description "What the researcher calls the repository chosen, such as ORDA." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:repository_name ],
        [ sh:class dd:RequirementSetUse ;
            sh:description "The sets the requirements were merged from, the standard's first." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dd:requirement_sets ],
        [ sh:datatype xsd:string ;
            sh:description "The repository's re3data identifier, such as r3d100012124." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:re3data_id ;
            sh:pattern "^r3d[0-9]{9}$" ],
        [ sh:description "The document kinds whose absence is a warning." ;
            sh:in ( "metadata_record" "readme" "data_dictionary" "dmp" "other" ) ;
            sh:order 6 ;
            sh:path dd:recommended_documents ],
        [ sh:description "The document kinds that must have an approved version before a package is built." ;
            sh:in ( "metadata_record" "readme" "data_dictionary" "dmp" "other" ) ;
            sh:order 5 ;
            sh:path dd:required_documents ],
        [ sh:datatype xsd:string ;
            sh:description "An override only: the media types the repository accepts. Empty means any." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dd:media_types ],
        [ sh:datatype xsd:string ;
            sh:description "What the set's sources leave open, each a short statement naming the issue that will settle it, such as \"Whether ORDA's form makes any other field mandatory (#385)\". Shown to the person depositing; in a merged set, the standard's first, then the override's." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dd:unconfirmed ],
        [ sh:class dd:RequirementField ;
            sh:description "The metadata properties the set requires or recommends." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dd:fields ],
        [ sh:description "The URI of the metadata schema of the standard's set." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:datatype xsd:string ;
            sh:description "What the researcher was told when the repository was chosen, such as that it does not list DataCite." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dd:warnings ],
        [ sh:datatype xsd:string ;
            sh:description "An override only: the licences the repository offers, each an SPDX identifier or the URL of the repository's own terms." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dd:licences ],
        [ sh:datatype xsd:integer ;
            sh:description "An override only: the largest file the repository accepts, in bytes." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dd:max_file_size ] ;
    sh:targetClass dd:RepositoryRequirements .

dd:RequirementField a sh:NodeShape ;
    rdfs:comment "One metadata property a requirement set requires or recommends." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Values that narrow the property, such as a subjectScheme. Part of what identifies a field when an override is merged with its standard's set." ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dd:qualifier ],
        [ sh:datatype xsd:string ;
            sh:description "The schema.org term the property maps to, by which the record is read as RDF." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:schema_org ],
        [ sh:in ( "required" "recommended" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path dd:obligation ],
        [ sh:datatype xsd:string ;
            sh:description "An override only: the label of the repository's deposit form field the value goes in." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:form_label ],
        [ sh:datatype xsd:string ;
            sh:description "The schema's property, such as DataCite's titles or types.resourceTypeGeneral." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:property ] ;
    sh:targetClass dd:RequirementField .

dd:RequirementSetUse a sh:NodeShape ;
    rdfs:comment "One requirement set a choice of repository was merged from, as the deployment held it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A requirement set, as <requirement_set_id>@v<version>." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:ref ;
            sh:pattern "^[a-z0-9][a-z0-9-]*@v[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "The SHA-256 digest of the set's file, in lowercase hex." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:sha256 ;
            sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:targetClass dd:RequirementSetUse .

dd:TableField a sh:NodeShape ;
    rdfs:comment "One field of a tabular resource, mirroring a Frictionless Table Schema field descriptor. Frictionless publishes no RDF namespace, so these slots carry see_also rather than a slot_uri (TODO(#20): revisit if Frictionless publishes term IRIs)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:field_format ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:name ],
        [ sh:datatype xsd:string ;
            sh:description "Frictionless field type (string, number, integer, boolean, date, datetime, time, duration, geopoint, ...)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:field_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:description ] ;
    sh:targetClass dd:TableField .

dd:DocumentVersionRef a sh:NodeShape ;
    rdfs:comment "One version of a project document: the document the conductor minted an identifier for, and the version's number within it, counted from 1." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifier the conductor minted for the document, a UUIDv7." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:document_id ;
            sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ],
        [ sh:datatype xsd:integer ;
            sh:description "The number of a version within its document, counted from 1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:version ] ;
    sh:targetClass dd:DocumentVersionRef .

