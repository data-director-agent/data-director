@prefix dd: <https://w3id.org/data-director/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dd:Message a sh:NodeShape ;
    rdfs:comment "One conversational turn addressed to an agent: the text of the turn and the conversation so far. The history is part of the input, so the input hash covers everything the agent saw. In a project that holds an inventory, the conductor adds what it is (docs/specs/projects.md); in any project, it adds the entry point chosen, the progress the project log shows and the project's title, if it has one (docs/specs/orchestration.md). It adds the researcher facts people in the project chose to keep from their public ORCID records (docs/specs/projects.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether a person gave the project its title, so that a model's would be refused; false while the project has no title. Filled by the conductor and never by the caller; absent when the run is in no project." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dd:project_title_by_researcher ],
        [ sh:class dd:ConversationTurn ;
            sh:description "The earlier turns of the conversation, oldest first." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dd:history ],
        [ sh:class dd:DocumentationSummary ;
            sh:description "The documents the conversation's project holds, without their text, filled by the conductor and never by the caller. Absent when the run is in no project, or its project holds none." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dd:project_documentation ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the researcher chose the project's entry point, so that a model's would be refused; false when an orchestrator's model recorded it. Filled by the conductor and never by the caller; absent when the run is in no project, or no entry point was recorded." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dd:project_entry_by_researcher ],
        [ sh:datatype xsd:integer ;
            sh:description "The Blueprint entry point (1, 2 or 3) the researcher chose for the conversation's project, the latest chosen. Filled by the conductor and never by the caller; absent when the run is in no project, or none was chosen." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:project_entry ],
        [ sh:class dd:StepProgress ;
            sh:description "The process-flow steps the conversation's project log shows started, done or skipped, in flow order. Filled by the conductor and never by the caller; absent when the run is in no project. Derived from the log on every turn, never stored." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dd:project_progress ],
        [ sh:class dd:ReplyAnswers ;
            sh:description "The researcher's answers to the questions the previous turn asked, when they answered them in the form. message_text still carries the answers as prose." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dd:reply_answers ],
        [ sh:class dd:InventorySummary ;
            sh:description "The inventory the conversation's project holds, filled by the conductor and never by the caller. Absent when the run is in no project, or its project holds no inventory." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dd:project_inventory ],
        [ sh:datatype xsd:string ;
            sh:description "The conversation's project's latest title. Filled by the conductor and never by the caller; absent when the run is in no project, or the project has no title yet." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dd:project_title ;
            sh:pattern "^.{1,200}$" ],
        [ sh:datatype xsd:string ;
            sh:description "What the user said in this turn." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:message_text ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:schema_class ],
        [ sh:class dd:ResearcherRecord ;
            sh:description "The researcher facts the conversation's project holds, one record for each person who kept some, filled by the conductor and never by the caller. Absent when the run is in no project, or nobody in its project kept any." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path dd:project_researchers ] ;
    sh:targetClass dd:Message .

dd:Affiliation a sh:NodeShape ;
    rdfs:comment "One affiliation on an ORCID record: an employment, an education or another kind, with the organisation and, where ORCID gives one, its identifier (ROR, GRID, Ringgold)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The researcher's role or degree." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dd:role_title ],
        [ sh:datatype xsd:string ;
            sh:description "ORCID's identifier for the item within the record, by which a researcher chose to keep it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:put_code ],
        [ sh:datatype xsd:string ;
            sh:description "The scheme of organisation_identifier, in ORCID's words, such as ROR, GRID or RINGGOLD. Present exactly when organisation_identifier is." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:organisation_identifier_scheme ],
        [ sh:datatype xsd:string ;
            sh:description "The department within the organisation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:department ],
        [ sh:description "What kind of affiliation the item is." ;
            sh:in ( "employment" "education" "qualification" "invited_position" "distinction" "membership" "service" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dd:affiliation_kind ],
        [ sh:datatype xsd:string ;
            sh:description "The organisation's identifier, where ORCID gives one: a URL for ROR, else as given." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:organisation_identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "The year it ended; absent while it continues." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dd:end_year ],
        [ sh:datatype xsd:integer ;
            sh:description "The year it started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dd:start_year ],
        [ sh:datatype xsd:string ;
            sh:description "The organisation's name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:organisation_name ] ;
    sh:targetClass dd:Affiliation .

dd:ConversationTurn a sh:NodeShape ;
    rdfs:comment "One earlier turn of a conversation, as the caller presents it to the agent. An agent turn names the agent and version that produced it and the invocation it came from." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "For an agent turn, the version of the agent that produced it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:turn_agent_version ],
        [ sh:datatype xsd:string ;
            sh:description "For an agent turn, the invocation it came from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:turn_invocation_id ;
            sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ],
        [ sh:in ( "user" "agent" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path dd:role ],
        [ sh:datatype xsd:string ;
            sh:description "What was said in the turn." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:turn_text ],
        [ sh:datatype xsd:string ;
            sh:description "For an agent turn, the agent that produced it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:turn_agent_id ] ;
    sh:targetClass dd:ConversationTurn .

dd:DocumentationSummary a sh:NodeShape ;
    rdfs:comment "What one document a researcher attached to a project is, without its text: the conductor fills one per document into a Message so that the agent knows the project holds it (docs/specs/projects.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "The size of the document's UTF-8 text, in bytes." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:documentation_size ],
        [ sh:datatype xsd:string ;
            sh:description "The document's media type, text/plain or text/markdown." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:documentation_media_type ],
        [ sh:datatype xsd:string ;
            sh:description "The SHA-256 of the document's UTF-8 text, by which the project keeps it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:documentation_digest ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the document was added to the project." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:documentation_added_at ],
        [ sh:datatype xsd:string ;
            sh:description "The file name the researcher attached the document under, without any folder." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:documentation_name ] ;
    sh:targetClass dd:DocumentationSummary .

dd:InventorySummary a sh:NodeShape ;
    rdfs:comment "What the inventory a project holds is, without its files: the conductor fills it into a Message so that the agent knows the project has one (docs/specs/projects.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The version of the command that made the inventory." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:inventory_tool_version ],
        [ sh:datatype xsd:integer ;
            sh:description "How many files the inventory lists." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:inventory_file_count ],
        [ sh:datatype xsd:string ;
            sh:description "The command that made the inventory, such as dd-inventory." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "The inventory's dd-input-json-v1 hash, by which the project keeps it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:inventory_digest ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "What the inventory left out or could not do, such as files it skipped." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:inventory_limitations ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the inventory was made." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass dd:InventorySummary .

dd:QuestionAnswer a sh:NodeShape ;
    rdfs:comment "The researcher's answer to one question of a reply, named by its question_key: the values of the options chosen, for a choice question, and the answer in their own words, for a text question or where a choice question allows it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The values of the options chosen, for a choice question; empty when the researcher answered in their own words, and always empty for a text question." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:answer_values ],
        [ sh:datatype xsd:string ;
            sh:description "The researcher's answer in their own words: the whole answer to a text question, or an answer given in place of an option where a choice question allows it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:answer_words ],
        [ sh:datatype xsd:string ;
            sh:description "The question_key of the question answered." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:answered_key ;
            sh:pattern "^[a-z][a-z0-9-]{0,39}$" ] ;
    sh:targetClass dd:QuestionAnswer .

dd:ReplyAnswers a sh:NodeShape ;
    rdfs:comment "The researcher's answers to the questions the turn before asked, given together: one QuestionAnswer for each question answered, none for a question skipped. The app checks them against those questions before it sends the turn (docs/specs/orchestration.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dd:QuestionAnswer ;
            sh:description "One answer for each question answered, in the order asked; at least one." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dd:given_answers ],
        [ sh:datatype xsd:string ;
            sh:description "The invocation whose reply asked the questions." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:answer_to ;
            sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ] ;
    sh:targetClass dd:ReplyAnswers .

dd:ResearcherFunding a sh:NodeShape ;
    rdfs:comment "One grant or award on an ORCID record, with its funder." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "The year it ended; absent while it continues." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dd:end_year ],
        [ sh:datatype xsd:string ;
            sh:description "The scheme of funder_identifier, in ORCID's words, such as FUNDREF or ROR. Present exactly when funder_identifier is." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:funder_identifier_scheme ],
        [ sh:datatype xsd:string ;
            sh:description "The funder's identifier, where ORCID gives one, such as a Crossref Funder ID." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:funder_identifier ],
        [ sh:datatype xsd:string ;
            sh:description "The kind of funding, in ORCID's words, such as grant or award." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:funding_type ],
        [ sh:datatype xsd:string ;
            sh:description "The funder's name." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:funder_name ],
        [ sh:datatype xsd:string ;
            sh:description "ORCID's identifier for the item within the record, by which a researcher chose to keep it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:put_code ],
        [ sh:datatype xsd:string ;
            sh:description "The grant number or award identifier, where the record gives one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dd:award_identifier ],
        [ sh:datatype xsd:integer ;
            sh:description "The year it started." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dd:start_year ],
        [ sh:datatype xsd:string ;
            sh:description "The grant's or award's title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:funding_title ] ;
    sh:targetClass dd:ResearcherFunding .

dd:ResearcherLink a sh:NodeShape ;
    rdfs:comment "A web page the researcher lists on their ORCID record, such as a personal page." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The page's address." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dd:link_url ],
        [ sh:datatype xsd:string ;
            sh:description "The name the researcher gave the page." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:link_title ] ;
    sh:targetClass dd:ResearcherLink .

dd:ResearcherRecord a sh:NodeShape ;
    rdfs:comment "What one researcher in a project chose to keep from their public ORCID record: only the sections and items they ticked, in ORCID's own words, never edited by a person or a model. The conductor fills the project's records into a Message and a DraftRequest so that an agent can draft creators, affiliations, subjects and funding from them (docs/specs/projects.md). Email addresses are never kept, even public ones." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The researcher's biography, as their ORCID record gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:biography ],
        [ sh:datatype xsd:string ;
            sh:description "A country the researcher's ORCID record names, as an ISO 3166-1 alpha-2 code." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:country ],
        [ sh:datatype xsd:integer ;
            sh:description "How many works the record held beyond the 50 offered. Absent when none were left out." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dd:works_omitted ],
        [ sh:datatype xsd:dateTime ;
            sh:description "When the record was read from ORCID's public API." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dd:record_retrieved_at ],
        [ sh:datatype xsd:string ;
            sh:description "The researcher's name as their ORCID record gives it: the credit name, else the given and family names. Absent when they keep their name private or did not keep it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:researcher_name ],
        [ sh:class dd:Affiliation ;
            sh:description "The researcher's affiliations they kept, the current ones first." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dd:affiliations ],
        [ sh:datatype xsd:string ;
            sh:description "The researcher's own keywords for their research, as their ORCID record lists them." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:keywords ],
        [ sh:description "The researcher's ORCID iD, as its URL, such as https://orcid.org/0000-0002-1825-0097." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dd:orcid_id ],
        [ sh:class dd:ResearcherWork ;
            sh:description "The researcher's works they kept, the most recent first: at most 50 are offered, so that an agent's input stays bounded." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dd:works ],
        [ sh:datatype xsd:string ;
            sh:description "Other names the researcher is known by, as their ORCID record lists them." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:other_names ],
        [ sh:class dd:ExternalIdentifier ;
            sh:description "The researcher's identifiers in other schemes, as their ORCID record lists them." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dd:external_identifiers ],
        [ sh:class dd:ResearcherLink ;
            sh:description "The web pages the researcher's ORCID record lists." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dd:researcher_links ],
        [ sh:class dd:ResearcherFunding ;
            sh:description "The researcher's grants and awards they kept, the current ones first." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path dd:fundings ],
        [ sh:description "The public API address the record was read from." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dd:record_source ] ;
    sh:targetClass dd:ResearcherRecord .

dd:ResearcherWork a sh:NodeShape ;
    rdfs:comment "One work on an ORCID record, such as a journal article or a dataset." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "ORCID's identifier for the item within the record, by which a researcher chose to keep it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:put_code ],
        [ sh:class dd:ExternalIdentifier ;
            sh:description "The work's identifiers, such as its DOI." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dd:work_identifiers ],
        [ sh:datatype xsd:string ;
            sh:description "The work's title." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:work_title ],
        [ sh:datatype xsd:string ;
            sh:description "The work's type, in ORCID's words, such as journal-article or data-set." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:work_type ],
        [ sh:datatype xsd:integer ;
            sh:description "The year the work was published." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:publication_year ],
        [ sh:datatype xsd:string ;
            sh:description "Where the work was published, such as a journal's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dd:journal_title ] ;
    sh:targetClass dd:ResearcherWork .

dd:StepProgress a sh:NodeShape ;
    rdfs:comment "How far one step of the Blueprint's process flow has gone, as the project log shows it: started, done or skipped. A step the list leaves out is open (docs/specs/orchestration.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A process-flow step id, `<phase>.<step>` (dd_sdk.process_flow)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:step_id ;
            sh:pattern "^[a-z]+\\.[a-z-]+$" ],
        [ sh:in ( "started" "done" "skipped" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dd:step_state ] ;
    sh:targetClass dd:StepProgress .

dd:ExternalIdentifier a sh:NodeShape ;
    rdfs:comment "An identifier from another scheme, as an ORCID record gives it: for a researcher, such as a Scopus Author ID; for a work, such as a DOI." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The identifier as a URL, where the record gives one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dd:identifier_url ],
        [ sh:datatype xsd:string ;
            sh:description "The scheme, in ORCID's words, such as doi or Scopus Author ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:identifier_type ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier within its scheme." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:identifier_value ] ;
    sh:targetClass dd:ExternalIdentifier .

