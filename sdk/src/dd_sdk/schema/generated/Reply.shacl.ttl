@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dd: <https://w3id.org/data-director/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dd:Reply a sh:NodeShape ;
    rdfs:comment "The payload of a conversational agent: the text of its reply. An orchestrator's reply is grounded on its input and on the envelopes of the invocations it delegated to." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "The Blueprint entry point (1, 2 or 3) a model worked out from what the researcher said, such as data already collected. The conductor records it for the conversation's project when the run succeeds, unless the researcher has chosen one; absent when the reply records none. Only an agent that declares it model-derived sets it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dd:new_project_entry ],
        [ sh:description "How reply_text came about. template for a rule-based agent, model for a model." ;
            sh:in ( "template" "model" "lexical" "registry" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dd:reply_derivation ],
        [ sh:datatype xsd:string ;
            sh:description "The reply, as prose." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:reply_text ],
        [ sh:class dd:Question ;
            sh:description "The questions the reply asks, in the order they are put to the researcher one at a time; between 1 and 8, with unique question_key values. Absent when the reply asks nothing or asks in prose." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dd:reply_questions ],
        [ sh:class dd:GroundingRef ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dd:grounded_on ],
        [ sh:datatype xsd:string ;
            sh:description "A short label a person can tell the conversation apart by, written by a model from the researcher's first message. Set only on a conversation's first turn, and only by an agent that declares it model-derived; absent otherwise." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:title ;
            sh:pattern "^.{1,80}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:schema_class ],
        [ sh:datatype xsd:string ;
            sh:description "A name for the conversation's project, written by a model once it knows what the research or dataset is. The conductor records it as the project's title when the run succeeds, unless a person has given one; absent when the reply names nothing. Only an agent that declares it model-derived sets it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:title ;
            sh:pattern "^.{1,80}$" ] ;
    sh:targetClass dd:Reply .

dd:ChoiceOption a sh:NodeShape ;
    rdfs:comment "One option of a choice question (a Question of kind choice)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "One sentence that helps the researcher tell this option from the others." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dd:option_help ],
        [ sh:datatype xsd:string ;
            sh:description "What the agent reads back when the option is chosen. A string, never a number: a number reaches the agent as a floating-point value over A2A." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:option_value ],
        [ sh:datatype xsd:string ;
            sh:description "What the researcher reads." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:option_label ] ;
    sh:targetClass dd:ChoiceOption .

dd:GroundingRef a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:content_hash ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:source_id ] ;
    sh:targetClass dd:GroundingRef .

dd:Question a sh:NodeShape ;
    rdfs:comment "One question a conversational agent asks the researcher in its reply, shown as a form field and answered with the reply's other questions in the next turn. A choice question has a fixed set of options, of which one or several may be chosen, and where question_other is true the researcher may answer in their own words instead; option values are unique within the question. A short or long text question is answered in the researcher's own words and has no options. Asking never suspends the run: the researcher may skip a question, or ignore them all and type (docs/specs/orchestration.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "True when the researcher may answer in their own words instead of an option. Choice questions only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dd:question_other ],
        [ sh:datatype xsd:string ;
            sh:description "One or two sentences shown under the question to help the researcher answer it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dd:question_help ],
        [ sh:class dd:ChoiceOption ;
            sh:description "The options of a choice question, in the order they are shown; between 2 and 12, with unique values. Absent for a text question." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dd:question_options ],
        [ sh:datatype xsd:boolean ;
            sh:description "True when several options may be chosen; one only otherwise. Choice questions only." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dd:question_multiple ],
        [ sh:datatype xsd:string ;
            sh:description "The question's identifier within its reply, which an answer names: a lower-case letter, then up to 39 lower-case letters, digits and hyphens." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dd:question_key ;
            sh:pattern "^[a-z][a-z0-9-]{0,39}$" ],
        [ sh:description "How the question is answered." ;
            sh:in ( "choice" "short_text" "long_text" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dd:question_kind ],
        [ sh:datatype xsd:string ;
            sh:description "The question, as a short line a person reads before the options." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dd:question_prompt ] ;
    sh:targetClass dd:Question .

