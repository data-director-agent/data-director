	sh:targetClass dd:InstitutionRepository .
dd:IntakeAnswer a sh:NodeShape ;
	rdfs:comment "The researcher's current answer to one of the intake's setup questions beside the entry question (dd_sdk.intake), as the project log shows it, with the labels of the options chosen (docs/specs/orchestration.md, invariant 20)." ;
