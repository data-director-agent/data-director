prov:Activity a sh:NodeShape ;
	rdfs:comment "One call an agent made to a language model, as the agent reports it (docs/specs/disclosure.md). model_id is the model the provider's response named, which may be more exact than the one configured. prompt_digest identifies the messages sent: the harness keeps them beside the run, never in the envelope, and checks that they hash to it." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n124 ;
	sh:property _:c14n261 , _:c14n271 , _:c14n286 , _:c14n36 , _:c14n57 , _:c14n59 ;
	sh:targetClass prov:Activity .
prov:Agent a sh:NodeShape ;
	rdfs:comment "The human an invocation acted for (Blueprint §5.4), or the accountable human role where it acted for an institution. Named by the deployment's authentication boundary and recorded by the conductor; a request cannot name one, and an agent is never sent one (docs/specs/policy-and-identity.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4 ;
	sh:property _:c14n105 , _:c14n162 , _:c14n215 , _:c14n78 , _:c14n89 ;
	sh:targetClass prov:Agent .
dd:ApprovedMetadataRecord a sh:NodeShape ;
	rdfs:comment "The project's metadata record as a person approved it: the version named by the last approval of a metadata_record document in the project (docs/specs/projects.md). A drafter treats what it holds as supplied, given by a person (docs/specs/drafting.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n0 ;
	sh:property _:c14n108 , _:c14n18 , _:c14n236 , _:c14n266 ;
	sh:targetClass dd:ApprovedMetadataRecord .
dd:ChoiceAnswer a sh:NodeShape ;
	rdfs:comment "The researcher's answer to the choice question the turn before asked: the values they chose and any text they gave in place of an option. The app checks it against that question before it sends the turn (docs/specs/orchestration.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n46 ;
	sh:property _:c14n115 , _:c14n211 , _:c14n8 ;
	sh:targetClass dd:ChoiceAnswer .
dd:ChoiceOption a sh:NodeShape ;
	rdfs:comment "One option of a choice question." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n147 ;
	sh:property _:c14n155 , _:c14n217 , _:c14n244 ;
	sh:targetClass dd:ChoiceOption .
dd:ChoiceQuestion a sh:NodeShape ;
	rdfs:comment "A question with a fixed set of options that a conversational agent asks the researcher in its reply, to be answered by choosing rather than typing. One or several options may be chosen, and where question_other is true the researcher may answer in their own words instead. Option values are unique within the question. Asking never suspends the run: the researcher may ignore the question and type (docs/specs/orchestration.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n32 ;
	sh:property _:c14n11 , _:c14n191 , _:c14n242 , _:c14n65 ;
	sh:targetClass dd:ChoiceQuestion .
dd:ConversationTurn a sh:NodeShape ;
	rdfs:comment "One earlier turn of a conversation, as the caller presents it to the agent. An agent turn names the agent and version that produced it and the invocation it came from." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n63 ;
	sh:property _:c14n1 , _:c14n10 , _:c14n17 , _:c14n171 , _:c14n224 ;
	sh:targetClass dd:ConversationTurn .
dd:CurrentVersion a sh:NodeShape ;
	rdfs:comment "The version of a project document that a drafter is to regenerate: the document's latest, its text, and its state with the reason a person gave for any decision on it (ADR-0036 decision 7). A drafter that regenerates it names version_ref in its payload's revises." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n81 ;
	sh:property _:c14n221 , _:c14n229 , _:c14n23 , _:c14n235 , _:c14n257 , _:c14n62 ;
	sh:targetClass dd:CurrentVersion .
dd:Delegation a sh:NodeShape ;
	rdfs:comment "One child invocation an agent in grounding mode delegation made through the harness (docs/specs/orchestration.md). Recorded by the conductor from its own run of the child, never reported by the agent. content_hash is the dd-envelope-json-v1 hash of the child envelope, which is what a relayed reply cites." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n7 ;
	sh:property _:c14n157 , _:c14n178 , _:c14n207 , _:c14n27 , _:c14n82 ;
	sh:targetClass dd:Delegation .
dd:Document a sh:NodeShape ;
	rdfs:comment "The payload of an agent that drafts or regenerates a project document: a metadata record, a README, a data dictionary or another document, as text (docs/specs/projects.md). The only payload class that becomes a project document." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n141 ;
	sh:property _:c14n106 , _:c14n123 , _:c14n135 , _:c14n181 , _:c14n186 , _:c14n197 , _:c14n219 , _:c14n228 , _:c14n61 , _:c14n90 ;
	sh:targetClass dd:Document .
dd:DocumentQuestion a sh:NodeShape ;
	rdfs:comment "A question a drafter asks the researcher about one gap in the version it drafted: a README section it could not write, or a data dictionary cell it could not fill. The target is either gap_section, with gap_part when the section is asked part by part, or gap_file, gap_field and gap_column together. question_id is derived from the target, so it is the same in every version that leaves the same gap (docs/specs/drafting.md). A question may offer a suggested_answer, with how it was derived (suggestion_derivation); a suggestion is never placed in the document, and becomes supplied only when a person records it as their answer." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n252 ;
	sh:property _:c14n104 , _:c14n160 , _:c14n199 , _:c14n277 , _:c14n50 , _:c14n53 , _:c14n58 , _:c14n70 , _:c14n80 ;
	sh:targetClass dd:DocumentQuestion .
dd:DocumentVersionRef a sh:NodeShape ;
	rdfs:comment "One version of a project document: the document the conductor minted an identifier for, and the version's number within it, counted from 1." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n273 ;
	sh:property _:c14n146 , _:c14n39 ;
	sh:targetClass dd:DocumentVersionRef .
dd:DocumentationSummary a sh:NodeShape ;
	rdfs:comment "What one document a researcher attached to a project is, without its text: the conductor fills one per document into a Message so that the agent knows the project holds it (docs/specs/projects.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n116 ;
	sh:property _:c14n148 , _:c14n170 , _:c14n208 , _:c14n66 , _:c14n99 ;
	sh:targetClass dd:DocumentationSummary .
dd:DraftAnswer a sh:NodeShape ;
	rdfs:comment "A person's answer to one question a version of the document asked (DocumentQuestion). The drafter places answer_text, as given, in the gap or cell the question names and marks it supplied (docs/specs/drafting.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n49 ;
	sh:property _:c14n195 , _:c14n237 ;
	sh:targetClass dd:DraftAnswer .
dd:DraftRequest a sh:NodeShape ;
	rdfs:comment "What a drafter is asked for: a project document of one kind, drafted from the project's facts (docs/specs/projects.md). Every agent that returns a Document accepts it, so an agent that drafts a document can replace another without its caller changing. The project's facts are the inventory, the requirements of the repository chosen, the metadata record a person approved last and, to regenerate a document, its current version with any decision on it. In a project, the conductor puts the inventory, the requirements and the metadata record in from the project, replacing whatever the caller sent, so a caller leaves them out; outside a project, the caller sends them. In a project the conductor also fills current_version, the latest version of the project's document of that kind, or of the document redraft_document names, so a redraft is that document's next version. The answers a person recorded to the current version's questions are filled in by the conductor in the same way (docs/specs/drafting.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n41 ;
	sh:property _:c14n169 , _:c14n183 , _:c14n196 , _:c14n204 , _:c14n239 , _:c14n42 , _:c14n43 , _:c14n54 ;
	sh:targetClass dd:DraftRequest .
dd:Envelope a sh:NodeShape ;
	rdfs:comment "The agent's response. Every field an agent did not decide (identifiers, timestamps, telemetry, the policy applied, the human it acted for) is filled by the conductor, so an agent cannot mislabel its own run. Conditional rules not expressible in JSON Schema are enforced by contract.validate: failed or suspended requires problem; abstained or referred requires outcome.reason_code; succeeded requires payload; a payload requires payload_schema, and payload_schema a payload." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n85 ;
	sh:property _:c14n101 , _:c14n113 , _:c14n119 , _:c14n12 , _:c14n120 , _:c14n129 , _:c14n166 , _:c14n193 , _:c14n198 , _:c14n213 , _:c14n214 , _:c14n238 , _:c14n24 , _:c14n262 , _:c14n263 , _:c14n270 , _:c14n31 , _:c14n35 , _:c14n48 , _:c14n5 , _:c14n71 ;
	sh:targetClass dd:Envelope .
dd:EvidenceItem a sh:NodeShape ;
	rdfs:comment "The retrieved content a grounding claim rests on, identified by a hash over its canonicalised projection (not the HTTP body)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n176 ;
	sh:property _:c14n121 , _:c14n16 , _:c14n194 , _:c14n212 , _:c14n44 , _:c14n47 , _:c14n67 , _:c14n76 ;
	sh:targetClass dd:EvidenceItem .
dd:FileInventory a sh:NodeShape ;
	rdfs:comment "The facts about a dataset's files that the project holds in place of the files (docs/specs/projects.md): for each file its path, size, digest and format, and for a table its fields. Made by a command run where the data live; it never contains a file's content. advisor.files reads it." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n34 ;
	sh:property _:c14n145 , _:c14n154 , _:c14n218 , _:c14n222 , _:c14n259 , _:c14n284 , _:c14n88 ;
	sh:targetClass dd:FileInventory .
dd:Grounded a sh:NodeShape ;
	rdfs:comment "Mixed into every payload class and every item class that asserts an identity. The linter walks a payload document for grounded_on lists and never needs to know the payload class; a payload that lacks grounded_on at its root is a violation, not a pass." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n201 ;
	sh:property _:c14n144 ;
	sh:targetClass dd:Grounded .
dd:GroundingRef a sh:NodeShape ;
	rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n251 ;
	sh:property _:c14n2 , _:c14n26 ;
	sh:targetClass dd:GroundingRef .
dd:Input a sh:NodeShape ;
	rdfs:comment "Any input: an object that names its class in schema_class. The core checks nothing else; the class schema of the agent's accepted input class does (docs/specs/contract.md)." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n45 ;
	sh:property _:c14n52 ;
	sh:targetClass dd:Input .
dd:InventoryFile a sh:NodeShape ;
	rdfs:comment "One file of a dataset, as the inventory command found it." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n6 ;
	sh:property _:c14n139 , _:c14n143 , _:c14n153 , _:c14n21 , _:c14n232 , _:c14n28 , _:c14n30 ;
	sh:targetClass dd:InventoryFile .
dd:InventorySummary a sh:NodeShape ;
	rdfs:comment "What the inventory a project holds is, without its files: the conductor fills it into a Message so that the agent knows the project has one (docs/specs/projects.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n93 ;
	sh:property _:c14n140 , _:c14n151 , _:c14n234 , _:c14n260 , _:c14n38 , _:c14n97 ;
	sh:targetClass dd:InventorySummary .
dd:InvocationRequest a sh:NodeShape ;
	rdfs:comment "What the conductor hands to an agent. One request produces exactly one Envelope. A conversation is the set of top-level invocations sharing a conversation_id; each turn is one request and one envelope (docs/specs/orchestration.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n133 ;
	sh:property _:c14n137 , _:c14n138 , _:c14n190 , _:c14n22 , _:c14n247 , _:c14n249 , _:c14n276 , _:c14n9 ;
	sh:targetClass dd:InvocationRequest .
dd:Message a sh:NodeShape ;
	rdfs:comment "One conversational turn addressed to an agent: the text of the turn and the conversation so far. The history is part of the input, so the input hash covers everything the agent saw. In a project that holds an inventory, the conductor adds what it is (docs/specs/projects.md); in any project, it adds the entry point chosen, the progress the project log shows and the project's title, if it has one (docs/specs/orchestration.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n275 ;
	sh:property _:c14n111 , _:c14n15 , _:c14n180 , _:c14n19 , _:c14n200 , _:c14n254 , _:c14n274 , _:c14n279 , _:c14n282 , _:c14n51 , _:c14n83 ;
	sh:targetClass dd:Message .
dd:Outcome a sh:NodeShape ;
	rdfs:comment "One class rather than a union of five. The status enum carries the vocabulary; reason_code is required when status is abstained or referred; problem (on the Envelope) is required when status is failed or suspended." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n226 ;
	sh:property _:c14n109 , _:c14n233 , _:c14n253 , _:c14n267 ;
	sh:targetClass dd:Outcome .
dd:Payload a sh:NodeShape ;
	rdfs:comment "Any payload: an object that names its class in schema_class and mixes in Grounded. The core checks nothing else; the class schema of the agent's payload class does (docs/specs/contract.md)." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n37 ;
	sh:property _:c14n189 , _:c14n205 ;
	sh:targetClass dd:Payload .
dd:ProblemDetails a sh:NodeShape ;
	rdfs:comment "RFC 9457 Problem Details for HTTP APIs, used verbatim for failed and suspended outcomes. The two extension members carry the resumption condition for suspended." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n216 ;
	sh:property _:c14n118 , _:c14n126 , _:c14n13 , _:c14n131 , _:c14n136 , _:c14n265 , _:c14n79 ;
	sh:targetClass dd:ProblemDetails .
dd:Reply a sh:NodeShape ;
	rdfs:comment "The payload of a conversational agent: the text of its reply. An orchestrator's reply is grounded on its input and on the envelopes of the invocations it delegated to." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n287 ;
	sh:property _:c14n100 , _:c14n114 , _:c14n174 , _:c14n230 , _:c14n248 , _:c14n269 , _:c14n77 , _:c14n91 ;
	sh:targetClass dd:Reply .
dd:RepositoryRequirements a sh:NodeShape ;
	rdfs:comment "The requirements of the repository a researcher chose: its standard's set with the repository's override, if there is one, merged on top (ADR-0038 decision 2). The harness makes it when the choice is recorded, keeps it among the project's blobs, gives it to the drafters and checks the project against it. Not a set of the deployment's configuration, so it has no requirement_set_id of its own; requirement_sets names the sets it was merged from." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n20 ;
	sh:property _:c14n134 , _:c14n163 , _:c14n172 , _:c14n179 , _:c14n223 , _:c14n241 , _:c14n246 , _:c14n258 , _:c14n278 , _:c14n280 , _:c14n3 , _:c14n96 ;
	sh:targetClass dd:RepositoryRequirements .
dd:RequirementField a sh:NodeShape ;
	rdfs:comment "One metadata property a requirement set requires or recommends." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n74 ;
	sh:property _:c14n117 , _:c14n128 , _:c14n14 , _:c14n250 , _:c14n264 ;
	sh:targetClass dd:RequirementField .
dd:RequirementSet a sh:NodeShape ;
	rdfs:comment "What a deposit must or should have (docs/specs/deposit.md). A standard's set covers any record in one metadata standard and names it in re3data_names; a repository override adds what one repository asks and names it in re3data_id. The harness merges the two for the repository a researcher chose, checks the project against the result, and gives it to the drafters. Kept as YAML in the deployment's configuration, not sent by agents." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n69 ;
	sh:property _:c14n122 , _:c14n130 , _:c14n158 , _:c14n168 , _:c14n185 , _:c14n210 , _:c14n231 , _:c14n255 , _:c14n272 , _:c14n283 , _:c14n29 , _:c14n33 , _:c14n40 , _:c14n56 , _:c14n60 , _:c14n87 ;
	sh:targetClass dd:RequirementSet .
dd:RequirementSetUse a sh:NodeShape ;
	rdfs:comment "One requirement set a choice of repository was merged from, as the deployment held it." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n107 ;
	sh:property _:c14n268 , _:c14n64 ;
	sh:targetClass dd:RequirementSetUse .
dd:StepProgress a sh:NodeShape ;
	rdfs:comment "How far one step of the Blueprint's process flow has gone, as the project log shows it: started, done or skipped. A step the list leaves out is open (docs/specs/orchestration.md)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n72 ;
	sh:property _:c14n150 , _:c14n98 ;
	sh:targetClass dd:StepProgress .
dd:TableField a sh:NodeShape ;
	rdfs:comment "One field of a tabular resource, mirroring a Frictionless Table Schema field descriptor. Frictionless publishes no RDF namespace, so these slots carry see_also rather than a slot_uri (TODO(#20): revisit if Frictionless publishes term IRIs)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n94 ;
	sh:property _:c14n102 , _:c14n161 , _:c14n173 , _:c14n202 ;
	sh:targetClass dd:TableField .
dd:Telemetry a sh:NodeShape ;
	rdfs:comment "Run measurements. The energy slots exist so P14 can be populated later without a schema change; at v0 they are null and not_measured." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n86 ;
	sh:property _:c14n125 , _:c14n225 , _:c14n256 , _:c14n281 , _:c14n285 , _:c14n288 , _:c14n92 ;
	sh:targetClass dd:Telemetry .
linkml:Any a sh:NodeShape ;
	rdfs:comment "Placeholder range for slots whose value type is enumerated in any_of." ;
	sh:closed true ;
