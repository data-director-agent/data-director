@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dd: <https://w3id.org/data-director/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
prov:Agent a sh:NodeShape ;
	rdfs:comment "The human an invocation acted for (Blueprint §5.4), or the accountable human role where it acted for an institution. Named by the deployment's authentication boundary and recorded by the conductor; a request cannot name one, and an agent is never sent one (ADR-0018)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n2 ;
	sh:property _:c14n33 , _:c14n40 , _:c14n43 , _:c14n73 , _:c14n84 ;
	sh:targetClass prov:Agent .
dd:ConversationTurn a sh:NodeShape ;
	rdfs:comment "One earlier turn of a conversation, as the caller presents it to the agent. An agent turn names the agent and version that produced it and the invocation it came from." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n26 ;
	sh:property _:c14n0 , _:c14n106 , _:c14n5 , _:c14n78 , _:c14n9 ;
	sh:targetClass dd:ConversationTurn .
dd:Delegation a sh:NodeShape ;
	rdfs:comment "One child invocation an agent in grounding mode delegation made through the harness (ADR-0012). Recorded by the conductor from its own run of the child, never reported by the agent. content_hash is the dd-envelope-json-v1 hash of the child envelope, which is what a relayed reply cites." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4 ;
	sh:property _:c14n14 , _:c14n35 , _:c14n71 , _:c14n82 , _:c14n96 ;
	sh:targetClass dd:Delegation .
dd:Document a sh:NodeShape ;
	rdfs:comment "The payload of an agent that drafts or regenerates a project document: a metadata record, a README, a data dictionary or another document, as text (ADR-0035). The only payload class that becomes a project document." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n60 ;
	sh:property _:c14n104 , _:c14n110 , _:c14n25 , _:c14n41 , _:c14n44 , _:c14n83 , _:c14n85 , _:c14n91 , _:c14n92 ;
	sh:targetClass dd:Document .
dd:DocumentVersionRef a sh:NodeShape ;
	rdfs:comment "One version of a project document: the document the conductor minted an identifier for, and the version's number within it, counted from 1." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n126 ;
	sh:property _:c14n17 , _:c14n66 ;
	sh:targetClass dd:DocumentVersionRef .
dd:Envelope a sh:NodeShape ;
	rdfs:comment "The agent's response. Every field an agent did not decide (identifiers, timestamps, telemetry, the policy applied, the human it acted for) is filled by the conductor, so an agent cannot mislabel its own run. Conditional rules not expressible in JSON Schema are enforced by contract.validate: failed or suspended requires problem; abstained or referred requires outcome.reason_code; succeeded requires payload; a payload requires payload_schema, and payload_schema a payload." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n37 ;
	sh:property _:c14n100 , _:c14n102 , _:c14n116 , _:c14n120 , _:c14n124 , _:c14n125 , _:c14n15 , _:c14n27 , _:c14n3 , _:c14n30 , _:c14n50 , _:c14n51 , _:c14n6 , _:c14n62 , _:c14n64 , _:c14n65 , _:c14n76 , _:c14n90 , _:c14n93 , _:c14n98 ;
	sh:targetClass dd:Envelope .
dd:EvidenceItem a sh:NodeShape ;
	rdfs:comment "The retrieved content a grounding claim rests on, identified by a hash over its canonicalised projection (not the HTTP body)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n80 ;
	sh:property _:c14n10 , _:c14n18 , _:c14n20 , _:c14n28 , _:c14n32 , _:c14n52 , _:c14n8 , _:c14n99 ;
	sh:targetClass dd:EvidenceItem .
dd:Grounded a sh:NodeShape ;
	rdfs:comment "Mixed into every payload class and every item class that asserts an identity. The linter walks a payload document for grounded_on lists and never needs to know the payload class; a payload that lacks grounded_on at its root is a violation, not a pass." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n94 ;
	sh:property _:c14n63 ;
	sh:targetClass dd:Grounded .
dd:GroundingRef a sh:NodeShape ;
	rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (ADR-0015). The linter matches every GroundingRef against a retrieval span on both fields." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n117 ;
	sh:property _:c14n1 , _:c14n13 ;
	sh:targetClass dd:GroundingRef .
dd:Input a sh:NodeShape ;
	rdfs:comment "Any input: an object that names its class in schema_class. The core checks nothing else; the class schema of the agent's accepted input class does (ADR-0019)." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n19 ;
	sh:property _:c14n24 ;
	sh:targetClass dd:Input .
dd:InvocationRequest a sh:NodeShape ;
	rdfs:comment "What the conductor hands to an agent. One request produces exactly one Envelope. A conversation is the set of top-level invocations sharing a conversation_id; each turn is one request and one envelope (ADR-0012)." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n57 ;
	sh:property _:c14n11 , _:c14n115 , _:c14n129 , _:c14n21 , _:c14n39 , _:c14n59 , _:c14n89 ;
	sh:targetClass dd:InvocationRequest .
dd:Message a sh:NodeShape ;
	rdfs:comment "One conversational turn addressed to an agent: the text of the turn and the conversation so far. The history is part of the input, so the input hash covers everything the agent saw." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n128 ;
	sh:property _:c14n131 , _:c14n23 , _:c14n46 ;
	sh:targetClass dd:Message .
dd:Outcome a sh:NodeShape ;
	rdfs:comment "One class rather than a union of five. The status enum carries the vocabulary; reason_code is required when status is abstained or referred; problem (on the Envelope) is required when status is failed or suspended." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n108 ;
	sh:property _:c14n111 , _:c14n118 , _:c14n122 , _:c14n45 ;
	sh:targetClass dd:Outcome .
dd:Payload a sh:NodeShape ;
	rdfs:comment "Any payload: an object that names its class in schema_class and mixes in Grounded. The core checks nothing else; the class schema of the agent's payload class does (ADR-0019)." ;
	sh:closed false ;
	sh:ignoredProperties _:c14n16 ;
	sh:property _:c14n88 , _:c14n95 ;
	sh:targetClass dd:Payload .
dd:ProblemDetails a sh:NodeShape ;
	rdfs:comment "RFC 9457 Problem Details for HTTP APIs, used verbatim for failed and suspended outcomes. The two extension members carry the resumption condition for suspended." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n103 ;
	sh:property _:c14n121 , _:c14n34 , _:c14n49 , _:c14n54 , _:c14n56 , _:c14n58 , _:c14n7 ;
	sh:targetClass dd:ProblemDetails .
dd:Reply a sh:NodeShape ;
	rdfs:comment "The payload of a conversational agent: the text of its reply. An orchestrator's reply is grounded on its input and on the envelopes of the invocations it delegated to." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n134 ;
	sh:property _:c14n123 , _:c14n132 , _:c14n42 , _:c14n48 ;
	sh:targetClass dd:Reply .
dd:Telemetry a sh:NodeShape ;
	rdfs:comment "Run measurements. The energy slots exist so P14 can be populated later without a schema change; at v0 they are null and not_measured." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n38 ;
	sh:property _:c14n107 , _:c14n119 , _:c14n130 , _:c14n133 , _:c14n135 , _:c14n53 ;
	sh:targetClass dd:Telemetry .
linkml:Any a sh:NodeShape ;
	rdfs:comment "Placeholder range for slots whose value type is enumerated in any_of." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n47 ;
	sh:targetClass linkml:Any .
