# Copy to .env. Nothing here is read unless a stage actually calls a model —
# the v0.1 sample run does not.
#
# Named env.example rather than .env.example so it is not swept up by tooling
# that ignores dot-env files wholesale.

ANTHROPIC_API_KEY=

# Provider and model, as a LangChain "provider:model" string (§1.4).
# Switching provider is a change to this line plus installing that provider package.
DD_MODEL_ID=anthropic:claude-opus-5

# Agent identity, written into every run record (C13).
DD_AGENT_IDENTITY=urn:dd:agent:sheffield-r3

# Rows read from the head of a data file (§1.4 — the head, never the whole file).
DD_HEAD_ROWS=500

# LANGSMITH_TRACING is deliberately unset. langsmith is an unavoidable dependency of
# langchain-core, but with no key and no flag nothing is exported anywhere.

# Which registry route to use. `empty` (the default) refuses to search rather than returning no
# results, so an abstention says "we could not look" and not "we looked and found nothing".
DD_REGISTRY_ROUTE=empty

# Versioned configuration, by filename stem in config/. A new weighting or question set is a new
# file plus a change to these lines, never an edit in place.
DD_RANKING_CONFIG=ranking.v1
DD_INTAKE_CONFIG=intake.v1
