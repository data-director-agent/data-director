{
  "$defs": {
    "ColumnProfile": {
      "additionalProperties": false,
      "description": "One column, as inferred locally from sampled values. R3.4 depends on this.",
      "properties": {
        "blank_count": {
          "title": "Blank Count",
          "type": "integer"
        },
        "blank_proportion": {
          "title": "Blank Proportion",
          "type": "number"
        },
        "distinct_count": {
          "title": "Distinct Count",
          "type": "integer"
        },
        "distinct_count_is_exact": {
          "title": "Distinct Count Is Exact",
          "type": "boolean"
        },
        "example_values": {
          "items": {
            "type": "string"
          },
          "title": "Example Values",
          "type": "array"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "inferred_type": {
          "$ref": "#/$defs/ColumnType"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "sample_size": {
          "title": "Sample Size",
          "type": "integer"
        },
        "type_derivation": {
          "$ref": "#/$defs/Derivation"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "position",
        "file",
        "inferred_type",
        "type_derivation",
        "sample_size",
        "blank_count",
        "blank_proportion",
        "distinct_count",
        "distinct_count_is_exact"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "ColumnType": {
      "description": "What tier-1 inference concluded a column holds.\n\nThese are the categories \u00a75.1 names, and R3.4 rests entirely on them: a column recognised\nas dates yields an ISO 8601 recommendation with near-total confidence and no model\ninvolved.",
      "enum": [
        "date",
        "datetime",
        "number",
        "quantity_with_unit",
        "categorical",
        "identifier",
        "coordinate",
        "free_text",
        "empty"
      ],
      "title": "ColumnType",
      "type": "string"
    },
    "ContentFingerprint": {
      "additionalProperties": false,
      "description": "Identifies the input, so C17 caching can be added later without reworking run records.",
      "properties": {
        "algorithm": {
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "files_hashed": {
          "title": "Files Hashed",
          "type": "integer"
        },
        "total_bytes": {
          "title": "Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "total_bytes",
        "files_hashed"
      ],
      "title": "ContentFingerprint",
      "type": "object"
    },
    "Derivation": {
      "description": "How a statement in a profile was arrived at.",
      "enum": [
        "supplied_metadata",
        "file_extension",
        "file_magic",
        "local_parse",
        "model_from_registry_list",
        "model_inferred"
      ],
      "title": "Derivation",
      "type": "string"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Format"
        },
        "format_derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_tabular": {
          "default": false,
          "title": "Is Tabular",
          "type": "boolean"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rows_sampled": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows Sampled"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "format",
        "format_derivation",
        "size_bytes"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "MeasuredVariable": {
      "additionalProperties": false,
      "description": "A variable named in the free-text description (\u00a75.1 tier 3). None at v0.1.",
      "properties": {
        "derivation": {
          "$ref": "#/$defs/Derivation"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        }
      },
      "required": [
        "name",
        "derivation"
      ],
      "title": "MeasuredVariable",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where the profile's inputs came from and when it was built.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "locations": {
          "items": {
            "type": "string"
          },
          "title": "Locations",
          "type": "array"
        },
        "metadata_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata Record"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "description": "A controlled term, with the list it came from and how it got here.",
      "properties": {
        "derivation": {
          "$ref": "#/$defs/Derivation"
        },
        "list_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "List Name"
        },
        "list_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "List Version"
        },
        "term": {
          "title": "Term",
          "type": "string"
        }
      },
      "required": [
        "term",
        "derivation"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "\u00a76.1.",
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnProfile"
      },
      "title": "Columns",
      "type": "array"
    },
    "entity_scope": {
      "items": {
        "$ref": "#/$defs/Term"
      },
      "title": "Entity Scope",
      "type": "array"
    },
    "fields_of_research": {
      "items": {
        "$ref": "#/$defs/Term"
      },
      "title": "Fields Of Research",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "title": "Files",
      "type": "array"
    },
    "fingerprint": {
      "$ref": "#/$defs/ContentFingerprint"
    },
    "formats_found": {
      "items": {
        "type": "string"
      },
      "title": "Formats Found",
      "type": "array"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "measured_variables": {
      "items": {
        "$ref": "#/$defs/MeasuredVariable"
      },
      "title": "Measured Variables",
      "type": "array"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "profiled_at": {
      "title": "Profiled At",
      "type": "string"
    },
    "profiler_version": {
      "title": "Profiler Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/Term"
      },
      "title": "Subjects",
      "type": "array"
    },
    "target_repository": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Repository"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "profile_id",
    "fingerprint",
    "source",
    "profiled_at",
    "profiler_version"
  ],
  "title": "DatasetProfile",
  "type": "object"
}
