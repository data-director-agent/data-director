{
  "ui:readonly": true,
  "ui:order": ["outcome", "agent_id", "agent_version", "invocation_id", "completed_at", "requires_human_review", "payload", "evidence", "telemetry", "problem"],
  "invocation_id": { "ui:options": { "dd:derivation": "verified" } },
  "agent_id": { "ui:options": { "dd:derivation": "verified" } },
  "agent_version": { "ui:options": { "dd:derivation": "verified" } },
  "completed_at": { "ui:options": { "dd:derivation": "verified" } },
  "requires_human_review": { "ui:widget": "derivationBadge", "ui:options": { "dd:derivation": "verified" } },
  "outcome": {
    "status": { "ui:widget": "derivationBadge", "ui:options": { "dd:derivation": "verified" } },
    "reason_code": { "ui:options": { "dd:derivation": "verified" } },
    "referred_to": { "ui:options": { "dd:derivation": "verified" } },
    "statement": { "ui:widget": "textarea", "ui:options": { "dd:derivation": "verified" } }
  },
  "payload": {
    "searched": {
      "queries": { "ui:options": { "dd:derivation": "verified" } },
      "snapshot_ref": { "ui:options": { "dd:derivation": "verified" } }
    },
    "items": {
      "items": {
        "ui:order": ["kind", "target", "resource", "score", "rationale", "rationale_derivation", "classification_derivation", "evidence_hashes"],
        "kind": { "ui:widget": "derivationBadge", "ui:options": { "dd:derivation": "lexical", "dd:derivation_field": "classification_derivation" } },
        "target": { "ui:options": { "dd:derivation": "verified" } },
        "resource": { "ui:options": { "dd:derivation": "verified" } },
        "score": { "ui:options": { "dd:derivation": "verified" } },
        "rationale": { "ui:widget": "derivationBadge", "ui:options": { "dd:derivation": "model", "dd:derivation_field": "rationale_derivation" } },
        "rationale_derivation": { "ui:widget": "hidden" },
        "classification_derivation": { "ui:widget": "hidden" },
        "evidence_hashes": { "ui:widget": "evidenceHashes" }
      }
    }
  },
  "evidence": { "ui:widget": "hidden" },
  "telemetry": {
    "model_id": { "ui:options": { "dd:derivation": "verified" } },
    "energy_estimate_j": { "ui:options": { "dd:derivation": "verified" } },
    "energy_method": { "ui:options": { "dd:derivation": "verified" } }
  }
}
