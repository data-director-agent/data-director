# Copy to .env (or export) as needed. Nothing here is required for `uv run pytest`.

# R3 retrieval backend: snapshot (default; data/fairsharing/snapshot.jsonl) or live.
DD_R3_RETRIEVAL=snapshot
# FAIRsharing account, needed only for live *search* (record fetch is public).
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=

# R3 explainer: template (default, deterministic, no key) or anthropic.
DD_R3_EXPLAINER=template
DD_MODEL_ID=claude-opus-5
# ANTHROPIC_API_KEY is read by the Anthropic SDK itself (or use `ant auth login`).
ANTHROPIC_API_KEY=

# Where runs are written (envelopes, spans, crates). Default: ./runs
DD_RUNS_DIR=runs
# Write a Process Run Crate per invocation (1) or not (0).
DD_WRITE_CRATE=1
# Alternative snapshot or profiles directory.
# DD_SNAPSHOT_PATH=data/fairsharing/snapshot.jsonl
# DD_PROFILES_DIR=profiles
