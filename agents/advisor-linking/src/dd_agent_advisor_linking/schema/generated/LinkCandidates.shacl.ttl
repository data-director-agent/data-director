@prefix linking: <https://w3id.org/data-director/agents/linking/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

linking:LinkCandidates a sh:NodeShape ;
    rdfs:comment "Identifiers of the publications, people, organisations, grants and software a researcher wants to link a dataset to, as they were given: DOIs, ORCID iDs, ROR ids, grant numbers or anything else." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifiers to link, each as given." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path linking:identifiers ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ] ;
    sh:targetClass linking:LinkCandidates .

