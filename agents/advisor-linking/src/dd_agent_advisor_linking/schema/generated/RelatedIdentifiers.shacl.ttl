@prefix linking: <https://w3id.org/data-director/agents/linking/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

linking:RelatedIdentifiers a sh:NodeShape ;
    rdfs:comment "The payload of advisor.linking: each identifier recognised, checked for form and put in canonical form, with a suggested way to record it, and a DOI's title and type where it was resolved. It suggests linking metadata for the researcher to review; registering the links stays with the researcher and the repository (R11)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How the summary came about: template, the rules' own summary, or model, where a model wrote it from the findings." ;
            sh:in ( "template" "model" "lexical" "registry" "answer" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path linking:summary_derivation ],
        [ sh:datatype xsd:string ;
            sh:description "A short summary of the findings in plain language, for the researcher. It restates the findings and changes none of them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path linking:summary ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:class linking:RelatedLink ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path linking:links ],
        [ sh:datatype xsd:string ;
            sh:description "What the adviser did not do, such as the identifiers it did not resolve." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linking:limitations ] ;
    sh:targetClass linking:RelatedIdentifiers .

<https://w3id.org/data-director/GroundingRef> a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/content_hash> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/source_id> ] ;
    sh:targetClass <https://w3id.org/data-director/GroundingRef> .

linking:RelatedLink a sh:NodeShape ;
    rdfs:comment "One identifier as given, and what the adviser made of it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The type of what a resolved identifier names, as the source gives it: a DOI's resource type, Person for an ORCID iD, or an organisation's first ROR type." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path linking:resource_type ],
        [ sh:datatype xsd:string ;
            sh:description "A suggested DataCite relationType, such as IsSupplementTo, for the researcher to confirm. Absent where the adviser cannot tell." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path linking:relation ],
        [ sh:datatype xsd:string ;
            sh:description "The scheme it was recognised as, from schemes.yaml (doi, orcid, ror, grant), or unknown." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path linking:scheme ],
        [ sh:datatype xsd:string ;
            sh:description "What the researcher should check or do with the identifier." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path linking:message ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the identifier (a DOI, ORCID iD or ROR id) was found through the tool gateway. Absent when no lookup was made; false when it was made and found nothing or failed, with the reason in message." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path linking:resolved ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the identifier is well formed for its scheme. True does not mean it exists: only a link with resolved true was looked up." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path linking:valid ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier's canonical https form, for a DOI, ORCID iD or ROR id." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path linking:normalised ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier, as given." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path linking:given ],
        [ sh:datatype xsd:string ;
            sh:description "What a resolved identifier names, as the source gives it: a DOI's title, a person's public name or an organisation's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path linking:title ] ;
    sh:targetClass linking:RelatedLink .

