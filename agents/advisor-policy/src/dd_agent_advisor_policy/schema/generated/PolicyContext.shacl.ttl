@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix policy: <https://w3id.org/data-director/agents/policy/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

policy:PolicyContext a sh:NodeShape ;
    rdfs:comment "Who funds, publishes and hosts the research, and what the data is. The agent looks up each actor's data policy." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "When the work the data supports is, or will be, published (YYYY, YYYY-MM or YYYY-MM-DD)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path policy:publication_date ;
            sh:pattern "^\\d{4}(-\\d{2}(-\\d{2})?)?$" ],
        [ sh:class policy:Actor ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path policy:actors ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:datatype xsd:string ;
            sh:description "Discipline or subject, as free text." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcat:theme ],
        [ sh:datatype xsd:string ;
            sh:description "What the data is, e.g. interview transcripts or household survey microdata." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path policy:data_kinds ] ;
    sh:targetClass policy:PolicyContext .

policy:Actor a sh:NodeShape ;
    rdfs:comment "A funder, journal or institution. The FAIRsharing identifier of its policy is used when given; otherwise the name is looked up." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The FAIRsharing identifier of the actor's policy, e.g. FAIRsharing.636kdn." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path policy:fairsharing_id ;
            sh:pattern "^FAIRsharing\\.\\S+$" ],
        [ sh:in ( "funder" "journal" "institution" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path policy:role ] ;
    sh:targetClass policy:Actor .

