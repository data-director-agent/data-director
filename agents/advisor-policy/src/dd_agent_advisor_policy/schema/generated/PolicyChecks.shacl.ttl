@prefix policy: <https://w3id.org/data-director/agents/policy/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

policy:PolicyChecks a sh:NodeShape ;
    rdfs:comment "The policy advisor payload. The policies matched to each actor, what each asks, where they differ, and the actors with no policy record. Conflicts are flagged for human review; the agent does not resolve them. Each funder identified in ROR is also proposed as a funder project fact, with its ROR identifier and Crossref Funder ID, for the researcher to confirm or reject (docs/specs/projects.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Actors for which no policy record was found in the registries searched. A registry in not_searched was not asked." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path policy:no_record ],
        [ sh:class policy:AmbiguousActor ;
            sh:description "Funders or journals whose name could mean more than one. The researcher should say which; their policies were not looked up." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path policy:ambiguous ],
        [ sh:class policy:SearchedSummary ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path policy:searched ],
        [ sh:class policy:NotSearched ;
            sh:description "The registries that could not be asked in this run, each with the reason. Empty when every registry the agent reads was asked." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path policy:not_searched ],
        [ sh:class policy:MatchedPolicy ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path policy:policies ],
        [ sh:class policy:PolicyConflict ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path policy:conflicts ],
        [ sh:class policy:RepositoryRef ;
            sh:description "Repositories a matched policy requires, as FAIRsharing relates them. Empty when no policy record names one, which is not evidence that none is mandated." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path policy:mandated_repositories ],
        [ sh:class policy:ResolvedJournal ;
            sh:description "The journals identified, each with its publisher and grounded on its record, so that the publisher's policy can be looked up." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path policy:journals ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:class policy:PolicyReading ;
            sh:description "What a model read in each policy's own text, or why the text was not read. Each obligation quotes the passage it comes from; a person confirms it." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path policy:readings ],
        [ sh:class <https://w3id.org/data-director/ProjectFact> ;
            sh:description "Facts the agent proposes for a person to confirm. A proposal is never a fact until a person decides it (docs/specs/projects.md)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path <https://w3id.org/data-director/proposed_facts> ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:class policy:ResolvedFunder ;
            sh:description "The funders identified in ROR, each grounded on its ROR record, so that the identifier can be passed on." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path policy:funders ],
        [ sh:datatype xsd:string ;
            sh:description "What this alpha does not yet do." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path policy:limitations ] ;
    sh:targetClass policy:PolicyChecks .

<https://w3id.org/data-director/ProjectFact> a sh:NodeShape ;
    rdfs:comment "One fact about a project that a check agent proposes and a person confirms: a funder, a repository a funder or institution requires, whether a file is deposited, whether a sensitive field or file may be published and at what precision, the licence, an output a data management plan committed to share, a standard, vocabulary or format the researcher chose for the dataset, or which attached document is the project's data management plan (docs/specs/projects.md). fact_kind says which of the value slots apply; fact_subject is the key a person's decision counts by, so the last decision on a subject stands. An agent's payload carries proposals in proposed_facts; only a person's decision makes one a fact, and the conductor gives the facts a person decided to every drafter and orchestrator in the project as project_decisions, without proposed_because." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The licence decided, as an SPDX identifier or a URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <https://w3id.org/data-director/licence_id> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the repository the plan committed to share the output in, as the plan names it; absent where it names none. A plan that names several for one output gives a sharing commitment for each." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path <https://w3id.org/data-director/commitment_repository> ],
        [ sh:datatype xsd:string ;
            sh:description "The kind of check that raised the fact, in the checking agent's words, such as duplicate, system_file or third_party. Kept as it was given; the core does not enumerate it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/data-director/fact_check_kind> ],
        [ sh:datatype xsd:string ;
            sh:description "The key a decision counts by within its kind: the funder's identifier or name, the repository's re3data identifier or name, the file's path, the field or path judged sensitive, licence, or the standard chosen and what it is chosen for. The last decision on a kind and subject stands." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/fact_subject> ;
            sh:pattern "\\S" ],
        [ sh:datatype xsd:string ;
            sh:description "The funders, journals or institutions that require the repository." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/data-director/fact_required_by> ],
        [ sh:description "The funder's ROR identifier, as a URL, where it is known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/fact_funder_ror> ],
        [ sh:description "The funder's Crossref Funder ID, as a DOI URL, where it is known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/data-director/fact_crossref_funder_id> ],
        [ sh:datatype xsd:string ;
            sh:description "The required repository's re3data identifier, such as r3d100010199, where known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/data-director/fact_re3data_id> ;
            sh:pattern "^r3d[0-9]{9}$" ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the licence the plan committed to, as the plan names it; absent where it names none." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path <https://w3id.org/data-director/commitment_licence> ],
        [ sh:description "Whether the file is to be deposited." ;
            sh:in ( "include" "exclude" "undecided" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path <https://w3id.org/data-director/file_decision> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the digest of the attached document's text (its documentation_digest) the quote is from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <https://w3id.org/data-director/commitment_document> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Why the agent proposes the fact, in a sentence for the person deciding. Kept with the proposal and shown to the person, never given to an agent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path <https://w3id.org/data-director/proposed_because> ],
        [ sh:datatype xsd:string ;
            sh:description "The funder's name, as its policy record or the researcher gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/fact_funder_name> ],
        [ sh:description "Whether the sensitive field or file may be published, and how." ;
            sh:in ( "publish" "generalise" "withhold" "undecided" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path <https://w3id.org/data-director/sensitivity_decision> ],
        [ sh:datatype xsd:string ;
            sh:description "The path of the file the fact is about, relative to the dataset's root folder, as the inventory gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/data-director/fact_file_path> ;
            sh:pattern "^[^/]" ],
        [ sh:datatype xsd:string ;
            sh:description "The required repository's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/data-director/fact_repository_name> ],
        [ sh:datatype xsd:string ;
            sh:description "For a standard fact, what the standard is chosen for: dataset, or field:<name> for one field of the dataset's tables. Absent means the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path <https://w3id.org/data-director/standard_target> ;
            sh:pattern "^(dataset|field:\\S.*)$" ],
        [ sh:description "What the fact is about, which says which value slots apply." ;
            sh:in ( "funder" "required_repository" "file_inclusion" "sensitivity" "licence" "sharing_commitment" "standard" "data_management_plan" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/fact_kind> ],
        [ sh:description "For a location that may be published or generalised, the precision agreed. Absent where the subject is not a location." ;
            sh:in ( "exact" "site" "region" "country" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path <https://w3id.org/data-director/location_precision> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, how openly the plan committed to share the output (such as open, embargoed or on request), as the plan says it; absent where it says nothing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://w3id.org/data-director/commitment_access> ],
        [ sh:datatype xsd:string ;
            sh:description "For a standard fact, the name of the standard, vocabulary, ontology or format chosen, as its registry record or the researcher gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <https://w3id.org/data-director/standard_name> ],
        [ sh:datatype xsd:string ;
            sh:description "For a data management plan fact, the digest of the attached document's text (its documentation_digest) that is the project's plan." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path <https://w3id.org/data-director/plan_document> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The field name, or the file path, judged sensitive, such as a lat or lon field, or a file of site coordinates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/data-director/sensitive_subject> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the plan's own words the commitment was read from, verbatim, so the person deciding can see the passage it rests on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path <https://w3id.org/data-director/commitment_quote> ],
        [ sh:description "For a standard fact, a persistent identifier of the standard, as a URL, such as its FAIRsharing DOI, where it is known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path <https://w3id.org/data-director/standard_id> ],
        [ sh:description "For a standard fact, what kind of standard was chosen, where it is known." ;
            sh:in ( "metadata_standard" "controlled_vocabulary" "ontology" "terminology" "data_format" "field_format" ) ;
            sh:maxCount 1 ;
            sh:order 22 ;
            sh:path <https://w3id.org/data-director/standard_kind> ] ;
    sh:targetClass <https://w3id.org/data-director/ProjectFact> .

policy:AmbiguousActor a sh:NodeShape ;
    rdfs:comment "A funder whose name could mean more than one organisation in ROR, or a journal title that could mean more than one journal. Grounded on each candidate, likeliest first; the agent does not choose. Its policy was not looked up: the researcher says which they mean, by giving its ROR identifier or ISSN." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "funder" "journal" "institution" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path policy:role ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the actor, as given in the input." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path policy:actor ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/grounded_on> ] ;
    sh:targetClass policy:AmbiguousActor .

policy:MatchedPolicy a sh:NodeShape ;
    rdfs:comment "One policy record matched to an actor, from FAIRsharing or Open Policy Finder. It is named only in grounded_on; the record's name, clauses and policies are in the cited evidence item's content (docs/specs/grounding.md). A record a model found with its tools, rather than the first search, has match_derivation model." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class policy:Obligation ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path policy:obligations ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:description "The registry the policy record came from." ;
            sh:in ( "fairsharing" "open_policy_finder" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path policy:registry ],
        [ sh:datatype xsd:string ;
            sh:description "Facts to weigh beside the obligations, such as a policy subject outside the discipline or a policy dated after the publication." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path policy:notes ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the actor, as given in the input." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path policy:actor ],
        [ sh:description "How the record was matched to the actor: registry, by the agent's fixed rule over the first search, or model, by a model with its search tools." ;
            sh:in ( "template" "model" "lexical" "registry" "answer" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path policy:match_derivation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path policy:rationale ],
        [ sh:in ( "template" "model" "lexical" "registry" "answer" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path policy:rationale_derivation ],
        [ sh:in ( "funder" "journal" "institution" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path policy:role ] ;
    sh:targetClass policy:MatchedPolicy .

policy:NotSearched a sh:NodeShape ;
    rdfs:comment "A registry that was not asked in this run, and why: it is not configured on this server, or it could not be reached. A policy it holds was not found, which is not the same as there being none." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Why it was not asked." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path policy:reason ],
        [ sh:description "The registry that was not asked." ;
            sh:in ( "fairsharing" "open_policy_finder" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path policy:registry ] ;
    sh:targetClass policy:NotSearched .

policy:Obligation a sh:NodeShape ;
    rdfs:comment "What a policy record says about one kind of obligation. Read from a curated field by a fixed rule (derivation registry), or stated by a model with a quote from the record that the agent found in it, word for word, before keeping it (derivation model)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "deposit" "data_availability_statement" "repository" "standard" "embargo" "licence" "timing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path policy:kind ],
        [ sh:datatype xsd:string ;
            sh:description "The value FAIRsharing's curators recorded, such as \"suggested\" or \"no\", kept so that an unstated strength does not hide what the record says." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path policy:recorded_as ],
        [ sh:datatype xsd:string ;
            sh:description "What the policy asks, in brief, e.g. \"within two years of the end of the grant\" or \"CC BY 4.0\"." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path policy:value ],
        [ sh:description "How the obligation was read, registry (a fixed rule) or model." ;
            sh:in ( "template" "model" "lexical" "registry" "answer" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path policy:derivation ],
        [ sh:datatype xsd:string ;
            sh:description "The words of the record that state the obligation, found in it word for word by the agent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path policy:quote ],
        [ sh:in ( "required" "recommended" "unstated" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path policy:strength ],
        [ sh:description "What the obligation is about: the data, or the publication (an open access policy's embargo or licence applies to the article, not the data)." ;
            sh:in ( "data" "publication" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path policy:scope ] ;
    sh:targetClass policy:Obligation .

policy:PolicyConflict a sh:NodeShape ;
    rdfs:comment "Matched policies that state one kind of obligation differently. Grounded on every policy involved, and flagged for human review." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:in ( "deposit" "data_availability_statement" "repository" "standard" "embargo" "licence" "timing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path policy:kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path policy:description ] ;
    sh:targetClass policy:PolicyConflict .

policy:PolicyReading a sh:NodeShape ;
    rdfs:comment "What a model read in one policy's own text, fetched from the address its policy record names or the researcher gave. Grounded on the text, and on the policy record it was reached from, if any. Each obligation kept quotes the text word for word, and the code has found the quote in it; what was dropped, and why, is in dropped. A person confirms each against the policy." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "What the model said that was not kept, and why, such as a quote not found in the text." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path policy:dropped ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the actor, as given in the input." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path policy:actor ],
        [ sh:in ( "funder" "journal" "institution" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path policy:role ],
        [ sh:in ( "read" "not_read" "unreadable" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path policy:status ],
        [ sh:datatype xsd:string ;
            sh:description "Why the text was not read, or was read in part." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path policy:reason ],
        [ sh:class policy:StatedObligation ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path policy:stated ] ;
    sh:targetClass policy:PolicyReading .

policy:RepositoryRef a sh:NodeShape ;
    rdfs:comment "A repository a policy requires, in the form advisor.repository takes as RepositoryNeeds.mandated." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path schema1:name ],
        [ sh:datatype xsd:string ;
            sh:description "The re3data identifier, e.g. r3d100010230." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path policy:re3data_id ;
            sh:pattern "^r3d\\d+$" ] ;
    sh:targetClass policy:RepositoryRef .

policy:ResolvedFunder a sh:NodeShape ;
    rdfs:comment "A funder identified in ROR. Its ROR identifier is stated only in grounded_on; what ROR records about it is in the cited evidence item's content (docs/specs/grounding.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The Crossref Funder ID ROR prefers for the funder, where it names one, e.g. 501100000270." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path policy:crossref_funder_id ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:datatype xsd:string ;
            sh:description "The name of the actor, as given in the input." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path policy:actor ] ;
    sh:targetClass policy:ResolvedFunder .

policy:ResolvedJournal a sh:NodeShape ;
    rdfs:comment "A journal identified in Crossref or Open Policy Finder, and the publisher whose policy it follows. Grounded on the journal's record." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The name of the actor, as given in the input." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path policy:actor ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:datatype xsd:string ;
            sh:description "The publisher's name, as the journal's record gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path policy:publisher ],
        [ sh:datatype xsd:string ;
            sh:description "A journal's ISSN, e.g. 0048-9697." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path policy:issn ;
            sh:pattern "^\\d{4}-?\\d{3}[\\dXx]$" ] ;
    sh:targetClass policy:ResolvedJournal .

policy:SearchedSummary a sh:NodeShape ;
    rdfs:comment "What was looked for, so a reader can judge an abstention as well as a match." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Which copy of the registry answered, e.g. fairsharing-policy:snapshot:2026-10-29." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path policy:snapshot_ref ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path policy:policies_retrieved ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path policy:queries ] ;
    sh:targetClass policy:SearchedSummary .

policy:StatedObligation a sh:NodeShape ;
    rdfs:comment "One obligation a policy's own text states, as a model read it: its kind, its strength and what it asks, with the passage that says so." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The words of the record that state the obligation, found in it word for word by the agent." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path policy:quote ],
        [ sh:in ( "deposit" "data_availability_statement" "repository" "standard" "embargo" "licence" "timing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path policy:kind ],
        [ sh:datatype xsd:string ;
            sh:description "What the policy asks, in brief, e.g. \"within two years of the end of the grant\" or \"CC BY 4.0\"." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path policy:value ],
        [ sh:in ( "required" "recommended" "unstated" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path policy:strength ] ;
    sh:targetClass policy:StatedObligation .

<https://w3id.org/data-director/GroundingRef> a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/content_hash> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/source_id> ] ;
    sh:targetClass <https://w3id.org/data-director/GroundingRef> .

