@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rights: <https://w3id.org/data-director/agents/rights/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rights:RightsContext a sh:NodeShape ;
    rdfs:comment "What the researcher has said about the dataset that bears on its licence and access: the reuse they want to allow, whether the data are sensitive, any licence they are required to use, and whether the data include content from third parties." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "Whether the data hold personal or otherwise sensitive information. Unknown if absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rights:sensitive ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data include content whose rights belong to others. Unknown if absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path rights:third_party_content ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:datatype xsd:string ;
            sh:description "The reuse the researcher wants to allow, e.g. any, attribution, share-alike or non-commercial. Unknown if absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rights:reuse_wanted ],
        [ sh:datatype xsd:string ;
            sh:description "The SPDX identifier of a licence that a funder, journal or institution requires, if any." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rights:mandated_licence ] ;
    sh:targetClass rights:RightsContext .

