@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix storage: <https://w3id.org/data-director/agents/storage/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

storage:StorageNeeds a sh:NodeShape ;
    rdfs:comment "What the researcher says about the data the project will hold while it runs: about how much, whether it involves personal data, and whether people outside the institution need access. The conductor fills institution_storage from the deployment's profile (GivenInstitutionStorage)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/data-director/InstitutionStorage> ;
            sh:description "The storage services the deployment's profile names as its institution's, filled by the conductor from the profile and never by the caller. Absent when the profile names none." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/data-director/institution_storage> ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:datatype xsd:integer ;
            sh:description "About how many gigabytes the project expects to hold, where the researcher knows." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path storage:expected_volume_gb ],
        [ sh:description "Whether the data involve personal or otherwise sensitive data, as the researcher says." ;
            sh:in ( "yes" "no" "unknown" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path storage:involves_personal_data ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether people outside the institution need access to the data while it runs." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path storage:external_collaborators ] ;
    sh:targetClass storage:StorageNeeds .

<https://w3id.org/data-director/InstitutionStorage> a sh:NodeShape ;
    rdfs:comment "One storage service the deployment's profile names as its institution's, for keeping data while a project runs (the profile's institution_storage, docs/specs/policy-and-identity.md). It holds only what the deployment vouches for: the conductor fills it into the input of an agent that mixes in GivenInstitutionStorage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The reference of the profile that vouches for the facts, as profile:<id>@v<version>; an agent cites them under it." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/profile_ref> ;
            sh:pattern "^profile:\\S+@v[0-9]+$" ],
        [ sh:description "The pages the deployment checked the facts it vouches for against." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path <https://w3id.org/data-director/guidance> ],
        [ sh:datatype xsd:string ;
            sh:description "The storage service's name, as the institution gives it to researchers." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/storage_name> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the institution approves the service for personal or otherwise sensitive data. Unknown when not given, which is never taken as approval." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/data-director/approved_for_sensitive> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the institution charges a project for storage there." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/data-director/charges_for_storage> ],
        [ sh:datatype xsd:string ;
            sh:description "What the service is for, in a sentence or two a researcher can read." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/storage_description> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether people outside the institution can be given access to data held there." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/data-director/allows_external_collaborators> ],
        [ sh:description "What kind of storage service it is." ;
            sh:in ( "institutional_filestore" "institutional_cloud" "managed_cloud" "secure_environment" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path <https://w3id.org/data-director/storage_kind> ],
        [ sh:datatype xsd:string ;
            sh:description "What the service does to keep copies, as the institution states it, such as nightly snapshots replicated to a second site." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path <https://w3id.org/data-director/storage_backup> ],
        [ sh:datatype xsd:string ;
            sh:description "The deployment's own label for a storage service, such as research-filestore: lower case letters, digits and hyphens." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/storage_id> ;
            sh:pattern "^[a-z0-9][a-z0-9-]*$" ],
        [ sh:datatype xsd:float ;
            sh:description "How many gigabytes a project may hold there without charge, where there is a limit." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/data-director/allowance_gb> ] ;
    sh:targetClass <https://w3id.org/data-director/InstitutionStorage> .

