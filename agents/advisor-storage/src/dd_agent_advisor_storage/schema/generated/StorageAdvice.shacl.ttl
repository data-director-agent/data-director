@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix storage: <https://w3id.org/data-director/agents/storage/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

storage:StorageAdvice a sh:NodeShape ;
    rdfs:comment "The payload of advisor.storage: the institution's storage services that may hold the data, in the order the rules put them, each with what it offers and any concern; the services left out, and why; and the questions a storage and backup plan answers. It is advisory: the researcher chooses, and no service is booked." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:class storage:StorageOption ;
            sh:description "The services that may hold the data, the most suitable first." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path storage:storage_options ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:class storage:ExcludedStorage ;
            sh:description "The services left out for this data, each with why." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path storage:excluded_storage ],
        [ sh:datatype xsd:string ;
            sh:description "The questions a storage and backup plan answers for this data, for the researcher to settle with the people who run the service." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path storage:plan_questions ],
        [ sh:description "How the summary came about: template, the rules' own summary, or model, where a model wrote it from the advice." ;
            sh:in ( "template" "model" "lexical" "registry" "answer" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path storage:summary_derivation ],
        [ sh:datatype xsd:string ;
            sh:description "A short summary of the advice in plain language, for the researcher. It restates the advice and changes none of it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path storage:summary ],
        [ sh:datatype xsd:string ;
            sh:description "What the adviser does not do." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path storage:limitations ] ;
    sh:targetClass storage:StorageAdvice .

storage:ExcludedStorage a sh:NodeShape ;
    rdfs:comment "One of the institution's storage services the rules leave out for this data, and why, grounded on what the profile vouches for about it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Why the rules leave the service out for this data." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path storage:excluded_because ],
        [ sh:datatype xsd:string ;
            sh:description "The deployment's own label for a storage service, such as research-filestore: lower case letters, digits and hyphens." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/storage_id> ;
            sh:pattern "^[a-z0-9][a-z0-9-]*$" ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/grounded_on> ] ;
    sh:targetClass storage:ExcludedStorage .

storage:StorageOption a sh:NodeShape ;
    rdfs:comment "One of the institution's storage services that may hold the data, grounded on what the profile vouches for about it." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "What the service offers that bears on this data, in plain words." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path storage:offers ],
        [ sh:datatype xsd:string ;
            sh:description "What the researcher should check before choosing the service." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path storage:concerns ],
        [ sh:datatype xsd:string ;
            sh:description "The deployment's own label for a storage service, such as research-filestore: lower case letters, digits and hyphens." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/storage_id> ;
            sh:pattern "^[a-z0-9][a-z0-9-]*$" ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/grounded_on> ] ;
    sh:targetClass storage:StorageOption .

<https://w3id.org/data-director/GroundingRef> a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/content_hash> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/source_id> ] ;
    sh:targetClass <https://w3id.org/data-director/GroundingRef> .

