@prefix files: <https://w3id.org/data-director/agents/files/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

files:FormatAssessment a sh:NodeShape ;
    rdfs:comment "The payload of advisor.files: each file of the inventory with the format it is judged to be, and whether that format is open. It judges from the inventory alone and reads no file. In a project it proposes, for each file it lists for a person to look at, a fact for a person to decide before deposit: whether the file goes in, or whether a file with coordinates may be published (#987)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "How the summary came about: template, the rules' own summary, or model, where a model wrote it from the findings." ;
            sh:in ( "template" "model" "lexical" "registry" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path files:summary_derivation ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:class files:FileCheck ;
            sh:description "The files a person should look at, in the inventory's order and, for each file, in the order of hints.yaml. Empty when no name, size or digest called for one, which says nothing about what the files hold." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path files:checks ],
        [ sh:datatype xsd:string ;
            sh:description "A short summary of the findings in plain language, for the researcher. It restates the findings and changes none of them." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path files:summary ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:datatype xsd:string ;
            sh:description "What this agent does not yet do." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path files:limitations ],
        [ sh:class files:FileAssessment ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path files:assessments ],
        [ sh:class <https://w3id.org/data-director/ProjectFact> ;
            sh:description "Facts the agent proposes for a person to confirm. A proposal is never a fact until a person decides it (docs/specs/projects.md)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path <https://w3id.org/data-director/proposed_facts> ] ;
    sh:targetClass files:FormatAssessment .

<https://w3id.org/data-director/GroundingRef> a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/content_hash> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/source_id> ] ;
    sh:targetClass <https://w3id.org/data-director/GroundingRef> .

<https://w3id.org/data-director/ProjectFact> a sh:NodeShape ;
    rdfs:comment "One fact about a project that a check agent proposes and a person confirms: a funder, a repository a funder or institution requires, whether a file is deposited, whether a sensitive field or file may be published and at what precision, the licence, or an output a data management plan committed to share (docs/specs/projects.md). fact_kind says which of the value slots apply; fact_subject is the key a person's decision counts by, so the last decision on a subject stands. An agent's payload carries proposals in proposed_facts; only a person's decision makes one a fact, and the conductor gives the facts a person decided to every drafter and orchestrator in the project as project_decisions, without proposed_because." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The licence decided, as an SPDX identifier or a URL." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path <https://w3id.org/data-director/licence_id> ],
        [ sh:datatype xsd:string ;
            sh:description "The kind of check that raised the fact, in the checking agent's words, such as duplicate, system_file or third_party. Kept as it was given; the core does not enumerate it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path <https://w3id.org/data-director/fact_check_kind> ],
        [ sh:datatype xsd:string ;
            sh:description "The funders, journals or institutions that require the repository." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <https://w3id.org/data-director/fact_required_by> ],
        [ sh:description "The funder's ROR identifier, as a URL, where it is known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/fact_funder_ror> ],
        [ sh:description "The funder's Crossref Funder ID, as a DOI URL, where it is known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/data-director/fact_crossref_funder_id> ],
        [ sh:datatype xsd:string ;
            sh:description "The required repository's re3data identifier, such as r3d100010199, where known." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <https://w3id.org/data-director/fact_re3data_id> ;
            sh:pattern "^r3d[0-9]{9}$" ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the licence the plan committed to, as the plan names it; absent where it names none." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path <https://w3id.org/data-director/commitment_licence> ],
        [ sh:datatype xsd:string ;
            sh:description "The key a decision counts by within its kind: the funder's identifier or name, the repository's re3data identifier or name, the file's path, the field or path judged sensitive, or licence. The last decision on a kind and subject stands." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/fact_subject> ;
            sh:pattern "\\S" ],
        [ sh:datatype xsd:string ;
            sh:description "Why the agent proposes the fact, in a sentence for the person deciding. Kept with the proposal and shown to the person, never given to an agent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path <https://w3id.org/data-director/proposed_because> ],
        [ sh:description "Whether the file is to be deposited." ;
            sh:in ( "include" "exclude" "undecided" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path <https://w3id.org/data-director/file_decision> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the digest of the attached document's text (its documentation_digest) the quote is from." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path <https://w3id.org/data-director/commitment_document> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:description "The funder's name, as its policy record or the researcher gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/fact_funder_name> ],
        [ sh:description "Whether the sensitive field or file may be published, and how." ;
            sh:in ( "publish" "generalise" "withhold" "undecided" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path <https://w3id.org/data-director/sensitivity_decision> ],
        [ sh:datatype xsd:string ;
            sh:description "The path of the file the fact is about, relative to the dataset's root folder, as the inventory gives it." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <https://w3id.org/data-director/fact_file_path> ;
            sh:pattern "^[^/]" ],
        [ sh:datatype xsd:string ;
            sh:description "The required repository's name." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/data-director/fact_repository_name> ],
        [ sh:description "What the fact is about, which says which value slots apply." ;
            sh:in ( "funder" "required_repository" "file_inclusion" "sensitivity" "licence" "sharing_commitment" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/fact_kind> ],
        [ sh:description "For a location that may be published or generalised, the precision agreed. Absent where the subject is not a location." ;
            sh:in ( "exact" "site" "region" "country" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path <https://w3id.org/data-director/location_precision> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, how openly the plan committed to share the output (such as open, embargoed or on request), as the plan says it; absent where it says nothing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path <https://w3id.org/data-director/commitment_access> ],
        [ sh:datatype xsd:string ;
            sh:description "The field name, or the file path, judged sensitive, such as a lat or lon field, or a file of site coordinates." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path <https://w3id.org/data-director/sensitive_subject> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the plan's own words the commitment was read from, verbatim, so the person deciding can see the passage it rests on." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path <https://w3id.org/data-director/commitment_quote> ],
        [ sh:datatype xsd:string ;
            sh:description "For a sharing commitment, the repository the plan committed to share the output in, as the plan names it; absent where it names none." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path <https://w3id.org/data-director/commitment_repository> ] ;
    sh:targetClass <https://w3id.org/data-director/ProjectFact> .

files:FileAssessment a sh:NodeShape ;
    rdfs:comment "One file of the inventory and the format it is judged to be." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The format the file is judged to be, from formats.yaml, or unknown." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path files:format_name ],
        [ sh:description "What the judgement rests on." ;
            sh:in ( "pronom" "pronom_unlisted" "media_type" "extension" "nothing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path files:judged_by ],
        [ sh:datatype xsd:string ;
            sh:description "The PRONOM identifier (PUID) the judgement rests on, or, when judged_by is pronom_unlisted, the first identifier the inventory gave. Absent when the inventory gave none that was used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path files:pronom_id ],
        [ sh:datatype xsd:string ;
            sh:description "The format's media type, from the inventory if it gave one, else from formats.yaml." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path files:media_type ],
        [ sh:datatype xsd:string ;
            sh:description "The file's path in the inventory (file_path)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path files:path ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether formats.yaml records the format as open. False for an unknown format." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path files:open_format ],
        [ sh:datatype xsd:string ;
            sh:description "The file name's last extension, lower case and without the dot; empty if none." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path files:extension ] ;
    sh:targetClass files:FileAssessment .

files:FileCheck a sh:NodeShape ;
    rdfs:comment "A file a person should look at before deposit, and why, judged from names, size and digest in the inventory alone (hints.yaml). A prompt for a person, never a finding about the file's contents, which are never read." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The word of a folder, file or field name, or the file name, that called for the check; absent for an empty file or a duplicate." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path files:matched ],
        [ sh:description "What the name, size or digest suggests." ;
            sh:in ( "free_text" "coordinates" "third_party" "governance" "system_file" "empty" "duplicate" "extension_mismatch" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path files:kind ],
        [ sh:datatype xsd:string ;
            sh:description "The file's path in the inventory (file_path)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path files:path ],
        [ sh:datatype xsd:string ;
            sh:description "What a person should check, from hints.yaml." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path files:question ],
        [ sh:datatype xsd:string ;
            sh:description "For a duplicate, the paths of the other files with the same digest." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path files:related_paths ] ;
    sh:targetClass files:FileCheck .

