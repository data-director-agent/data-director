@prefix files: <https://w3id.org/data-director/agents/files/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

files:FormatAssessment a sh:NodeShape ;
    rdfs:comment "The payload of advisor.files: each file of the inventory with the format it is judged to be, and whether that format is open. It judges from the inventory alone and reads no file." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:datatype xsd:string ;
            sh:description "What this mock does not yet do." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path files:limitations ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:class files:FileAssessment ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path files:assessments ] ;
    sh:targetClass files:FormatAssessment .

<https://w3id.org/data-director/GroundingRef> a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/content_hash> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/source_id> ] ;
    sh:targetClass <https://w3id.org/data-director/GroundingRef> .

files:FileAssessment a sh:NodeShape ;
    rdfs:comment "One file of the inventory and the format it is judged to be." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The format the file is judged to be, from formats.yaml, or unknown." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path files:format_name ],
        [ sh:description "What the judgement rests on." ;
            sh:in ( "media_type" "extension" "nothing" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path files:judged_by ],
        [ sh:datatype xsd:string ;
            sh:description "The format's media type, from the inventory if it gave one, else from formats.yaml." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path files:media_type ],
        [ sh:datatype xsd:string ;
            sh:description "The file's path in the inventory (file_path)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path files:path ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether formats.yaml records the format as open. False for an unknown format." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path files:open_format ],
        [ sh:datatype xsd:string ;
            sh:description "The file name's last extension, lower case and without the dot; empty if none." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path files:extension ] ;
    sh:targetClass files:FileAssessment .

