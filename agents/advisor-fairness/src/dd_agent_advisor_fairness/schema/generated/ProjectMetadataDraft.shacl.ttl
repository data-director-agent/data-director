@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fairness: <https://w3id.org/data-director/agents/fairness/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fairness:ProjectMetadataDraft a sh:NodeShape ;
    rdfs:comment "A request for feedback on the project's metadata record while it is drafted, at any point in the work. In a project the conductor gives the latest version of the record and the version a person approved last (GivenProjectMetadataRecord); outside one, the caller sends the record's text as draft_text." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class <https://w3id.org/data-director/CurrentVersion> ;
            sh:description "The latest version of the project's metadata record, proposed, approved or rejected, with its text and state. In a project the conductor fills it and a caller leaves it out. Absent when the project holds no metadata record." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path <https://w3id.org/data-director/project_metadata_draft> ],
        [ sh:datatype xsd:string ;
            sh:description "The text of a metadata record in DataCite's JSON form, sent by a caller outside a project. In a project the conductor's project_metadata_draft is read instead." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path fairness:draft_text ],
        [ sh:class <https://w3id.org/data-director/ApprovedMetadataRecord> ;
            sh:description "The version of the project's metadata record a person approved last. In a project the conductor fills it and a caller leaves it out. Absent when no version has been approved." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/project_metadata_approved> ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ] ;
    sh:targetClass fairness:ProjectMetadataDraft .

<https://w3id.org/data-director/ApprovedMetadataRecord> a sh:NodeShape ;
    rdfs:comment "The project's metadata record as a person approved it: the version named by the last approval of a metadata_record document in the project (docs/specs/projects.md). A drafter treats what it holds as supplied, given by a person (docs/specs/drafting.md)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "The schema or profile document_text follows, such as a repository's metadata schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dcterms:conformsTo ],
        [ sh:class <https://w3id.org/data-director/DocumentVersionRef> ;
            sh:description "The version, by its document and number." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/version_ref> ],
        [ sh:datatype xsd:string ;
            sh:description "The media type of document_text, such as text/markdown or application/json." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:format ],
        [ sh:datatype xsd:string ;
            sh:description "The content of the document, as text; a structured record is serialised." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/document_text> ] ;
    sh:targetClass <https://w3id.org/data-director/ApprovedMetadataRecord> .

<https://w3id.org/data-director/CurrentVersion> a sh:NodeShape ;
    rdfs:comment "The version of a project document that a drafter is to regenerate: the document's latest, its text, and its state with the reason a person gave for any decision on it (ADR-0036 decision 7). A drafter that regenerates it names version_ref in its payload's revises." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The content of the document, as text; a structured record is serialised." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path <https://w3id.org/data-director/document_text> ],
        [ sh:datatype xsd:string ;
            sh:description "The reason the person gave for their decision, in their words. Present for a rejection, and for an approval only if they gave one." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <https://w3id.org/data-director/decision_reason> ],
        [ sh:description "Whether a person has approved or rejected the version, or not yet decided." ;
            sh:in ( "proposed" "approved" "rejected" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path <https://w3id.org/data-director/version_state> ],
        [ sh:datatype xsd:string ;
            sh:description "The media type of document_text, such as text/markdown or application/json." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:format ],
        [ sh:class <https://w3id.org/data-director/DocumentVersionRef> ;
            sh:description "The version, by its document and number." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/version_ref> ],
        [ sh:datatype xsd:string ;
            sh:description "A short name a person can tell documents apart by, such as README for raw/." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ] ;
    sh:targetClass <https://w3id.org/data-director/CurrentVersion> .

<https://w3id.org/data-director/DocumentVersionRef> a sh:NodeShape ;
    rdfs:comment "One version of a project document: the document the conductor minted an identifier for, and the version's number within it, counted from 1." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The identifier the conductor minted for the document, a UUIDv7." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/document_id> ;
            sh:pattern "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" ],
        [ sh:datatype xsd:integer ;
            sh:description "The number of a version within its document, counted from 1." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/version> ] ;
    sh:targetClass <https://w3id.org/data-director/DocumentVersionRef> .

