@prefix ethics: <https://w3id.org/data-director/agents/ethics/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ethics:SensitivityContext a sh:NodeShape ;
    rdfs:comment "What the researcher has said about the dataset that bears on sensitive data: its field names, whether it involves people, and whether they intend an embargo." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A short description of the dataset." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path ethics:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the researcher intends an embargo. Unknown if absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path ethics:embargo_intended ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:datatype xsd:string ;
            sh:description "The names of the dataset's fields or columns." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path ethics:fields ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether the data were collected from or about people. Unknown if absent." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path ethics:involves_people ],
        [ sh:datatype xsd:string ;
            sh:description "The dataset's title." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path ethics:title ] ;
    sh:targetClass ethics:SensitivityContext .

