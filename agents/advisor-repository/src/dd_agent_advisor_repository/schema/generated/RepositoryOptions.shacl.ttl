@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix repository: <https://w3id.org/data-director/agents/repository/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

repository:RepositoryOptions a sh:NodeShape ;
    rdfs:comment "The repository advisor payload. Repositories recommended or described, each grounded on its registry records. The researcher selects; the agent does not." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mandated repositories for which no registry record was found." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path repository:not_found ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:class repository:SearchedSummary ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path repository:searched ],
        [ sh:datatype xsd:string ;
            sh:description "Type designator: the name of the class this object is an instance of. Discriminates the input and payload unions, and lets a consumer name a payload class it does not recognise." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/schema_class> ],
        [ sh:class repository:RepositoryCandidate ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path repository:candidates ] ;
    sh:targetClass repository:RepositoryOptions .

repository:RepositoryCandidate a sh:NodeShape ;
    rdfs:comment "One repository. It is named only in grounded_on; its name, PID systems, access and upload conditions, certificates and metadata standards are in the cited evidence items' content (docs/specs/grounding.md). The judgements here are read from those records or compared with the needs." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The needs this repository meets, as recorded by its registry entries." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path repository:meets ],
        [ sh:datatype xsd:string ;
            sh:description "Facts the researcher should weigh that are neither met nor missed needs: fees, a commercial platform, the deposit conditions FAIRsharing's curators record." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path repository:notes ],
        [ sh:description "Whether an institution responsible for the repository is listed as commercial." ;
            sh:in ( "yes" "no" "unstated" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path repository:commercial ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path repository:score ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path repository:rationale ],
        [ sh:datatype xsd:string ;
            sh:description "The needs this repository does not meet, or that its records leave open. Flagged for the researcher; never resolved by the agent." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path repository:misses ],
        [ sh:class <https://w3id.org/data-director/GroundingRef> ;
            sh:description "The retrieved things this object rests on. For grounding mode retrieval, each entry names a retrieval span; for input_only and none, the single entry is the input itself (source_id input:<invocation_id>, content_hash the dd-input-json-v1 hash)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path <https://w3id.org/data-director/grounded_on> ],
        [ sh:datatype xsd:string ;
            sh:description "Why a recommended repository is on the shortlist and in its place, one sentence per ranking signal: the themes and kinds of data it matches, whether it is a generalist, run by the researcher's institution, or lacks the access the data needs. Empty when mandated." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path repository:ranked_by ],
        [ sh:in ( "mandated" "recommended" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path repository:basis ],
        [ sh:description "Whether the registry lists a fee as a condition of depositing data." ;
            sh:in ( "yes" "no" "unstated" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path repository:fee_required ],
        [ sh:in ( "template" "model" "lexical" "registry" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path repository:rationale_derivation ],
        [ sh:description "Whether the registry lists a persistent identifier system the repository uses. re3data does not say whether assignment is automatic." ;
            sh:in ( "yes" "no" "unstated" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path repository:assigns_pids ] ;
    sh:targetClass repository:RepositoryCandidate .

repository:SearchedSummary a sh:NodeShape ;
    rdfs:comment "What was looked for, so a reader can judge an abstention as well as a recommendation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path repository:queries ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path repository:candidates_retrieved ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path repository:candidates_qualifying ],
        [ sh:datatype xsd:string ;
            sh:description "Which copies of the registries answered, e.g. re3data:export:2026-11." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path repository:snapshot_ref ] ;
    sh:targetClass repository:SearchedSummary .

<https://w3id.org/data-director/GroundingRef> a sh:NodeShape ;
    rdfs:comment "The identity and content hash of one retrieved thing a payload rests on. The only way a payload may name an external resource as a decided identity, and the only place it names it: what the reference identifies is read from the evidence item with the same source_id and content_hash (docs/specs/grounding.md). The linter matches every GroundingRef against a retrieval span on both fields." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path <https://w3id.org/data-director/content_hash> ;
            sh:pattern "^[0-9a-f]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <https://w3id.org/data-director/source_id> ] ;
    sh:targetClass <https://w3id.org/data-director/GroundingRef> .

