    entry2(["Entry 2: Data already collected — joins here"]):::entry
    phase2["PHASE 2: GOVERNANCE AND CONSTRAINTS OF RESEARCH DATA"]:::phase
    governs["Governs: funder policies, ethics, legal obligations, data sensitivity and embargo requirements"]:::caption
    policies["Check funder, journal and institutional data sharing policies<br><br><b>Guidance note:</b> Informs all subsequent decisions on sensitive data handling, ethical constraints and embargo period. The agent could connect to FAIRsharing policy records to surface relevant requirements. requirements."]:::step
    sensitive{"Is sensitive data present?"}:::decision
    anonymise["Anonymise or remove sensitive data<br><br><b>Guidance note:</b> The agent could warn, question or flag if sensitive data is detected. Data must be anonymised before the agent accesses it in cloud deployment. Air-gapped deployment allows more flexibility within a trusted boundary."]:::step
    nosensitive["No sensitive data — continue"]:::step
    constraints["Check ethical, legal and institutional constraints"]:::step
    embargo{"Is an embargo required?"}:::decision
    noembargo["No embargo required — continue"]:::step
    define["Define embargo period<br><br><b>Guidance note:</b> The agent could suggest a duration based on funder, journal and institutional requirements already identified above."]:::step
    verify["Verify data sharing at publication against Data Management Plan (DMP) commitments<br><br><b>R8:</b> Verify data sharing at publication against Data Management Plan (DMP) commitments"]:::step
    next["→ Entry 3 (Ready to deposit data) joins at Phase 3 (see next page)"]:::link

