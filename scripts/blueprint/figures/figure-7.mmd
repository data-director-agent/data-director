flowchart TB
    subgraph trust["Data Director Trust Boundary"]
        researcher(("Researcher")):::actor
        subgraph presentation["Presentation Layer"]
            subgraph webapp["Web App"]
                conversation["Conversation"]:::box
                feedback["Feedback"]:::box
            end
        end
        subgraph application["Application Layer"]
            appServices["App Services"]:::box
            appInsights["App Insights"]:::box
            appWorkflow["App Workflow"]:::box
        end
        aiEngineer(("AI Engineer")):::actor
        subgraph ai["AI Layer"]
            orchestration["AI Model Orchestration"]:::box
            evaluation["AI Model Evaluation"]:::box
            metrics["Groundness<br>Coherence<br>Fluency<br>Relevance<br>Similarity"]:::annotation
            development["AI Model Development"]:::box
            safety["Safety and Content Filtering"]:::box
            dashboard["AI Dashboard"]:::box
            subgraph runtime["Model Runtime (Compute, Region)"]
                planning["Planning Agent"]:::box
                linking["Linking Agent"]:::box
                metadataAgent["Metadata Agent"]:::box
                repository["Repository Agent"]:::box
                provenance["Provenance Agent"]:::box
                validation["Validation Agent"]:::box
            end
        end
        subgraph integration["Integration Layer"]
            apiManagement["API Management"]:::box
            policy["Policy"]:::box
            gateway["Gateway"]:::box
            analytics["Analytics"]:::box
        end
        dataEngineer(("Data Engineer")):::actor
        subgraph data["Data Layer"]
            metadataManagement["Metadata Management"]:::box
            lineage["Lineage"]:::box
            subgraph immutable["Immutable Storage"]
                auditLogs["Audit Logs"]:::box
                userFeedback["User Feedback"]:::box
                telemetry["Agent Telemetry"]:::box
            end
            nosql["NoSQL Document Store"]:::box
            subgraph storage["Storage"]
                online["Online"]:::box
                archive["Archive"]:::box
            end
            vectorDb["Vector Database"]:::box
            pipelines["Data Pipelines"]:::box
        end
        subgraph platform["Platform Layer"]
            identity["Identity Management"]:::box
            siem["Security, Incident & Event Management"]:::box
            monitoring["Operational Monitoring"]:::box
            secrets["Secret & Key Management"]:::box
        end
        itAdministrator(("IT Administrator")):::actor
    end

    subgraph external["External System Boundary"]
        apiInterface["API Interface"]:::box
        orcid["ORCID"]:::box
        datacite["DataCite (DOI / ROR)"]:::box
        zenodo["Zenodo (DOI)"]:::box
    end

    presentation <--> application
    appServices --> appInsights
    application <--> ai
    ai <--> integration
    integration <--> external
    ai <--> data

    evaluation ~~~ metrics
    researcher ~~~ presentation
    aiEngineer ~~~ ai
    dataEngineer ~~~ data
    platform ~~~ itAdministrator

