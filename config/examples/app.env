# The app's settings (development: config/local/app.env, which `dev.py setup` creates from this
# file; deployment: /etc/data-director/app.env, which deploy/install.sh does). Not committed.

# The address the app serves on. Default: 127.0.0.1:7860.
# DD_APP_HOST=127.0.0.1
# DD_APP_PORT=7860
# Where the agents call the app back to delegate (docs/specs/orchestration.md), if not at DD_APP_HOST:DD_APP_PORT.
# DD_HARNESS_URL=http://127.0.0.1:7860

# Whom every run acts for on a development server, which signs nobody in (docs/specs/policy-and-identity.md).
# This is the operator, not the person using the page, and every page says so. Required unless
# DD_OIDC_ISSUER is set; never set beside it.
DD_PRINCIPAL_ID=
DD_PRINCIPAL_NAME=
# DD_PRINCIPAL_KIND=person

# Signing people in with ORCID (docs/specs/policy-and-identity.md). Set these, and unset DD_PRINCIPAL_*, so that each run
# acts for the person who signed in. Register an ORCID public API client (free) whose redirect URI
# is DD_APP_PUBLIC_URL/api/sign-in/callback; use https://sandbox.orcid.org for development.
# DD_OIDC_ISSUER=https://orcid.org
# DD_OIDC_CLIENT_ID=APP-...
# The client secret, or a file that holds it (relative to $CREDENTIALS_DIRECTORY under systemd).
# Not both.
# DD_OIDC_CLIENT_SECRET=
# DD_OIDC_CLIENT_SECRET_FILE=
# Where people reach the app, as registered with ORCID. Default: http://DD_APP_HOST:DD_APP_PORT.
# DD_APP_PUBLIC_URL=https://data-director.example.ac.uk
# How long a session lasts, in seconds: after this long unused (default 8 hours), and at most
# (default 7 days). Sessions are held in memory, so restarting the app signs everyone out.
# DD_SESSION_IDLE_S=28800
# DD_SESSION_LIFETIME_S=604800

# A person's own model account (docs/specs/model-accounts.md). Where the browser reaches the model
# broker's enrolment interface: a path on this site, which the reverse proxy passes on to the
# broker (deploy/nginx/data-director.conf; the Vite dev server does the same). Unset: the Profile
# page offers no account. The harness must also mint model grants (DD_MODEL_GRANT_SIGNING_KEY,
# DD_MODEL_BROKER_SUBJECT_KEY and DD_PSEUDONYM_SECRET; docs/guide/operations/model-broker.md).
# DD_APP_MODEL_BROKER_URL=/broker

# The deployment's configuration (docs/specs/system.md). Each defaults to the app's reference set.
# DD_PROFILE=app/config/profile.yaml.example
# DD_AGENTS_CONFIG=app/config/agents.yaml
# DD_SOURCES_CONFIG=app/config/sources.yaml
# Where runs and projects are kept: a directory, or a postgresql:// URL that names no password
# (docs/specs/storage.md). `dd.py setup` writes the lines below for Docker Compose's `postgres`
# profile, whose containers override PGHOST, PGPORT and PGPASSFILE (compose.yaml).
# DD_RUNS_DIR=app/runs
# DD_PROJECTS_DIR=app/projects
# DD_RUNS_DIR=postgresql://dd@/dd
# DD_PROJECTS_DIR=postgresql://dd@/dd
# PGHOST=localhost
# PGPORT=5432
# PGPASSFILE=/path/to/config/local/credentials/pgpass
# The most connections each PostgreSQL store keeps open (10 by default; docs/specs/storage.md).
# DD_POSTGRES_POOL_SIZE=10
# DD_WRITE_CRATE=1

# Problem reports (docs/specs/app.md): the app files a GitHub issue for the person. Off without
# a credential. Use a GitHub App (preferred) or a token, not both; both need only Issues: write
# on the repository (deploy/README.md, "Problem reports", says how to create the App).
# The App: its ID, and the path of its private key (PEM), relative to $CREDENTIALS_DIRECTORY
# under systemd. The installation is found from the repository unless named.
# DD_FEEDBACK_GITHUB_APP_ID=
# DD_FEEDBACK_GITHUB_APP_PRIVATE_KEY_FILE=
# DD_FEEDBACK_GITHUB_APP_INSTALLATION_ID=
# A fine-grained token for the repository, or point _FILE at a file that holds it.
# DD_FEEDBACK_GITHUB_TOKEN=
# DD_FEEDBACK_GITHUB_TOKEN_FILE=
# DD_FEEDBACK_REPO=data-director-agent/data-director
# The commit shown as the build's, if the app is not run from a git checkout or a release that
# has a REVISION file.
# DD_REVISION=

# The app runs no agent and holds no model key (docs/specs/policy-and-identity.md, docs/specs/app.md). Each agent service reads its
# own settings and key (config/examples/agents/), not this file.

# Optional, Docker Compose only: host ports, if the defaults (7860, 5173, 8000, 5432) are in use.
# DD_APP_HOST_PORT=7860
# DD_WEB_HOST_PORT=5173
# DD_WORKBENCH_HOST_PORT=8000
# DD_DB_HOST_PORT=5432
