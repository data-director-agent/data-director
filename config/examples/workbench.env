# The settings of a deployed workbench (/etc/data-director/workbench.env, which deploy/install.sh
# creates from this file). Not committed. A workbench on a developer's machine needs none of
# these: without DD_OIDC_ISSUER it signs nobody in, and every run acts for the operator
# (workbench/README.md).

# Signing admins in with ORCID (docs/specs/policy-and-identity.md). The same issuer and client as
# the app's; register DD_WORKBENCH_PUBLIC_URL/api/sign-in/callback as a second redirect URI.
DD_OIDC_ISSUER=
DD_OIDC_CLIENT_ID=
# Where admins reach the workbench, as registered with ORCID.
DD_WORKBENCH_PUBLIC_URL=
# The ORCID iDs the workbench admits, separated by commas or spaces. Anyone else who signs in is
# refused. Required: the workbench does not start with none.
DD_WORKBENCH_ADMINS=
