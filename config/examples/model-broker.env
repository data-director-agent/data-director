# The model broker's settings (docs/guide/operations/model-broker.md). Its secrets are not here: they
# are root's files in /etc/data-director/credentials/model-broker/, which the unit loads.

# Where the harness publishes the keys it signs model grants with. TODO(#808): the harness does not
# publish them yet; until it does, the broker refuses every grant.
#DD_BROKER_HARNESS_JWKS_URL=

# Where the deployment's own calls go when the broker pays for them, such as the LiteLLM gateway
# (deploy/llm-gateway/README.md). Unset: straight to the provider.
#DD_BROKER_DEPLOYMENT_BASE_URL=http://127.0.0.1:4000

# Origins a person's own account may name as its base URL, comma-separated, and those of them that
# may resolve to a private address (an endpoint inside the institution). TODO(#811).
#DD_BROKER_ALLOWED_BASE_URLS=
#DD_BROKER_PRIVATE_BASE_URLS=
