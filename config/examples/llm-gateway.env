# The LiteLLM gateway's settings on a VM (deploy/llm-gateway/README.md, "On the VM"). Its secrets are
# not here: they are root's files in /etc/data-director/credentials/llm-gateway/, set with
#   sudo data-director secret set llm-gateway anthropic-api-key
# install.sh writes the gateway's own three (litellm-master-key, litellm-salt-key and
# postgres-password) the first time. Never change litellm-salt-key afterwards.
#
# The models are deploy/llm-gateway/config.yaml as install.sh last copied it. To choose others,
# copy that file to /etc/data-director/llm-gateway.yaml, edit it, and restart the gateway:
#   sudo systemctl restart data-director-llm-gateway

# Use the price list shipped with the gateway's image rather than one downloaded at start-up.
LITELLM_LOCAL_MODEL_COST_MAP=True

# The subnet of the gateway's Docker network. Choose a block that no campus network uses, such as
# a University's Wi-Fi range; Docker's own default can fall in one (172.18.0.0/16).
#DD_GATEWAY_SUBNET=10.201.0.0/24

# An Ollama server on the VM, for the llama-local model.
#OLLAMA_API_BASE=http://host.docker.internal:11434
