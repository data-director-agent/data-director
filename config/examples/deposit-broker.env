# The deposit broker's settings (docs/guide/operations/deposit-broker.md). Its secrets are not here:
# they are root's files in /etc/data-director/credentials/deposit-broker/, which the unit loads.

# Where the harness publishes the keys it signs deposit grants with: the app's /.well-known/jwks.json,
# once it has its model-grant secrets. Or DD_DEPOSIT_BROKER_HARNESS_JWKS_FILE, a copy of that JSON.
# On a VM, install.sh sets the URL, with the app's port, unless it is set already.
#DD_DEPOSIT_BROKER_HARNESS_JWKS_URL=http://127.0.0.1:7860/.well-known/jwks.json

# The repository API roots the broker may call, comma-separated, each transport=https://…. A grant
# naming any other is refused, which keeps a practice deployment on the sandbox.
DD_DEPOSIT_BROKER_ALLOWED_BASE_URLS=zenodo=https://sandbox.zenodo.org/api

# Where people reach the broker through the reverse proxy, and the app's own origin, to which they
# return after connecting an account through OAuth. On a VM, install.sh sets both from --domain.
#DD_DEPOSIT_BROKER_PUBLIC_URL=https://data-director.example.ac.uk/deposit-broker
#DD_DEPOSIT_BROKER_APP_URL=https://data-director.example.ac.uk
