# Settings every agent service reads (development: config/local/agents.env; deployment:
# /etc/data-director/agents.env). Each agent also reads config/local/agents/<name>.env after this.
# Never put a model key here: every agent would be given it (docs/specs/policy-and-identity.md). Keys go in
# credentials/, named by ANTHROPIC_API_KEY_FILE in the agent's own file.

# --- advisor.standards ---------------------------------------------------------------------
# Retrieval backend: snapshot (default) or live.
DD_STANDARDS_RETRIEVAL=snapshot
# FAIRsharing account, needed only for live *search* (record fetch is public). Put the password
# in credentials/ and name it in agents/advisor-standards.env as FAIRSHARING_PASSWORD_FILE if you share
# the machine.
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=
# Explainer: template (default, deterministic, no key) or anthropic.
DD_STANDARDS_EXPLAINER=template
# DD_SNAPSHOT_PATH=agents/advisor-standards/data/fairsharing/snapshot.jsonl

# --- advisor.policy ------------------------------------------------------------------------
# Retrieval backend: snapshot (default) or live. Live search needs the FAIRsharing account above,
# given to this agent in agents/advisor-policy.env; live falls back to the snapshot, marked stale.
DD_POLICY_RETRIEVAL=snapshot
# Explainer: template (default, deterministic, no key) or anthropic.
DD_POLICY_EXPLAINER=template

# --- advisor.repository --------------------------------------------------------------------
# FAIRsharing retrieval: snapshot (default) or live. The live route is public, and falls back to
# the committed snapshot, marked stale, when it fails. re3data is always read from the registry
# built from its pinned export (`uv run dd-re3data fetch`).
DD_REPOSITORY_RETRIEVAL=snapshot
# Explainer: template (default, deterministic, no key) or anthropic.
DD_REPOSITORY_EXPLAINER=template

# --- advisor.documentation -----------------------------------------------------------------
# README prose: template (default, no prose, no key) or anthropic, which has a model write the
# README's prose from the project's facts. Gaps, tables and data dictionaries are drafted by rule
# either way (agents/advisor-documentation/README.md).
DD_DOCUMENTATION_WRITER=template
