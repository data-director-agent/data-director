# Settings every agent service reads (development: config/local/agents.env; deployment:
# /etc/data-director/agents.env). Each agent also reads config/local/agents/<name>.env after this.
# Never put a model key here: every agent would be given it (ADR-0026). Keys go in
# credentials/, named by ANTHROPIC_API_KEY_FILE in the agent's own file.

# --- standards.advisor ---------------------------------------------------------------------
# Retrieval backend: snapshot (default) or live.
DD_STANDARDS_RETRIEVAL=snapshot
# FAIRsharing account, needed only for live *search* (record fetch is public). Put the password
# in credentials/ and name it in agents/standards.env as FAIRSHARING_PASSWORD_FILE if you share
# the machine.
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=
# Explainer: template (default, deterministic, no key) or anthropic.
DD_STANDARDS_EXPLAINER=template
# DD_SNAPSHOT_PATH=agents/standards/data/fairsharing/snapshot.jsonl
