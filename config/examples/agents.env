# Settings every agent service reads (development: config/local/agents.env; deployment:
# /etc/data-director/agents.env). Each agent also reads config/local/agents/<name>.env after this.
# Never put a model key here: every agent would be given it (docs/specs/policy-and-identity.md). Keys go in
# credentials/, named by ANTHROPIC_API_KEY_FILE in the agent's own file.

# --- advisor.standards ---------------------------------------------------------------------
# Retrieval backend: snapshot (default) or live.
DD_STANDARDS_RETRIEVAL=snapshot
# FAIRsharing account, needed only for live *search* (record fetch is public). Put the password
# in credentials/ and name it in agents/advisor-standards.env as FAIRSHARING_PASSWORD_FILE if you share
# the machine.
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=
# Advisor: model (default) has a model write each recommendation's rationale, note doubts about
# the ranking's picks and add standards it finds with its own searches, each checked by the agent;
# it needs the provider's key in the agent's own file (docs/guide/operations/ai-models.md).
# template needs no key: the ranking's picks only, with rationale from a template.
# DD_STANDARDS_EXPLAINER=model
# The most searches the model may make in one run (0 to 30; 4 by default).
# DD_STANDARDS_MAX_LOOKUPS=4
# DD_SNAPSHOT_PATH=agents/advisor-standards/data/fairsharing/snapshot.jsonl

# --- advisor.policy ------------------------------------------------------------------------
# Retrieval backend: snapshot (default) or live. Live search needs the FAIRsharing account above,
# given to this agent in agents/advisor-policy.env; live falls back to the snapshot, marked stale.
DD_POLICY_RETRIEVAL=snapshot
# Funders are identified in ROR first: snapshot (default) reads the registry built from the pinned
# ROR dump (`uv run dd-sources prepare`); live asks api.ror.org, which needs no account, and falls
# back to that registry, marked stale.
DD_POLICY_ROR=snapshot
# Advisor: model (default) has a model read the policy records found, search for more, and state
# each obligation with a quote the agent checks; it needs the provider's key in the agent's own
# file (docs/guide/operations/ai-models.md). template needs no key: rationale from a template and
# obligations from curated fields only. DD_POLICY_EXPLAINER is its older name.
# DD_POLICY_ADVISOR=model
# The most searches the model may make in one run (0 to 30; 6 by default).
# DD_POLICY_MAX_LOOKUPS=6
# Journals: Crossref names a journal's publisher, so its policy is found too: live (default) or off.
# DD_POLICY_CROSSREF=live
# Jisc Open Policy Finder (funders' and journals' open access policies) is searched when the
# agent's own file gives it a free key, OPEN_POLICY_FINDER_API_KEY_FILE
# (https://openpolicyfinder.jisc.ac.uk/help/developers/how-to-request-a-new-api-key).

# --- advisor.repository --------------------------------------------------------------------
# FAIRsharing retrieval: snapshot (default) or live. The live route is public, and falls back to
# the committed snapshot, marked stale, when it fails. re3data is always read from the registry
# built from its pinned export (`uv run dd-re3data fetch`).
DD_REPOSITORY_RETRIEVAL=snapshot
# Explainer: template (default, deterministic, no key) or model, set in the agent's own file
# with its provider (docs/guide/operations/ai-models.md).
DD_REPOSITORY_EXPLAINER=template

# --- advisor.documentation -----------------------------------------------------------------
# Writer: model (default) has a model write the README's prose and suggest answers to a draft's
# questions from the project's facts, and needs a key in the agent's own file
# (docs/guide/operations/ai-models.md); template writes no prose, suggests nothing and needs no
# key. Gaps, tables and data dictionaries are drafted by rule either way
# (agents/advisor-documentation/README.md). Left unset with no key, `dd.py start` runs it with
# template.
# DD_DOCUMENTATION_WRITER=model

# --- advisor.ethics ------------------------------------------------------------------------
# Reader: template (default) flags field names by keyword only and needs no key; model also has a
# model read the names, adding flags and questions but never removing a keyword flag, and needs
# the provider's key in the agent's own file (docs/guide/operations/ai-models.md). With model, the
# field names a caller sends are sent to that model: a hosted model is outside the institution,
# and the profile's hosted_models does not cover this input (TODO(#40)). A local model
# (DD_MODEL_PROVIDER=openai-compatible, DD_MODEL_BASE_URL on loopback) keeps them in; detecting
# personal data before anything is sent is TODO(#39) (agents/advisor-ethics/README.md).
# DD_ETHICS_READER=model

# --- calling models through the model broker -----------------------------------------------
# For a person's own model account (docs/guide/operations/model-broker.md). Set in each model-backed
# agent's own file rather than here, with its credential as a secret named exactly
# dd-model-broker-credential (DD_MODEL_BROKER_CREDENTIAL_FILE), and no provider key beside it.
# DD_MODEL_BROKER_URL=http://127.0.0.1:8300
