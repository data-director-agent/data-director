# The policy advisor's own settings (config/local/agents/advisor-policy.env). `dev.py setup` writes this
# when you give a FAIRsharing login.
DD_POLICY_RETRIEVAL=live
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=
# The model advisor is on by default and needs a key; DD_POLICY_ADVISOR=template runs without one.
# DD_POLICY_ADVISOR=model
# DD_MODEL_ID=
# The key file, relative to config/local/credentials/ (CREDENTIALS_DIRECTORY, as under systemd).
# ANTHROPIC_API_KEY_FILE=advisor-policy-anthropic-api-key
# A free Jisc Open Policy Finder key, so funders' and journals' open access policies are searched.
# Without it, a run that finds no policy for a funder or journal says it could not search.
# OPEN_POLICY_FINDER_API_KEY_FILE=advisor-policy-open-policy-finder-api-key
# Another provider instead of Anthropic (docs/guide/operations/ai-models.md, "Choose a provider"):
# DD_MODEL_PROVIDER=openai-compatible
# DD_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# DD_MODEL_ID=llama3.3
