# The policy advisor's own settings (config/local/agents/advisor-policy.env). `dev.py setup` writes this
# when you give a FAIRsharing login.
DD_POLICY_RETRIEVAL=live
FAIRSHARING_LOGIN=
FAIRSHARING_PASSWORD=
