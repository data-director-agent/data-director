# The standards advisor's own settings (config/local/agents/standards.env). `dev.py setup` writes
# this when you choose a model explainer.
DD_STANDARDS_EXPLAINER=anthropic
# DD_MODEL_ID=
# The key file, relative to config/local/credentials/ (CREDENTIALS_DIRECTORY, as under systemd).
ANTHROPIC_API_KEY_FILE=standards-anthropic-api-key
# Live FAIRsharing search; `dev.py setup` writes these when you give a FAIRsharing login.
# DD_STANDARDS_RETRIEVAL=live
# FAIRSHARING_LOGIN=
# FAIRSHARING_PASSWORD=
