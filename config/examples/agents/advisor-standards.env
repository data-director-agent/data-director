# The standards advisor's own settings (config/local/agents/advisor-standards.env). `dev.py setup` writes
# this when you choose a model explainer.
DD_STANDARDS_EXPLAINER=model
# DD_MODEL_ID=
# The key file, relative to config/local/credentials/ (CREDENTIALS_DIRECTORY, as under systemd).
ANTHROPIC_API_KEY_FILE=advisor-standards-anthropic-api-key
# Another provider instead of Anthropic (docs/guide/operations/ai-models.md, "Choose a provider"):
# DD_MODEL_PROVIDER=openai-compatible
# DD_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# DD_MODEL_ID=llama3.3
# Live FAIRsharing search; `dev.py setup` writes these when you give a FAIRsharing login.
# DD_STANDARDS_RETRIEVAL=live
# FAIRSHARING_LOGIN=
# FAIRSHARING_PASSWORD=
