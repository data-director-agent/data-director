# The orchestrator's own settings (config/local/agents/orchestrator-model.env). It always calls a
# model, so it stops at start-up without a key.
# The key file, relative to config/local/credentials/ (CREDENTIALS_DIRECTORY, as under systemd).
ANTHROPIC_API_KEY_FILE=orchestrator-model-anthropic-api-key
# The defaults: Claude Sonnet 5.5, at high effort, with the last 20 turns and up to four
# delegations a turn.
# DD_MODEL_ID=claude-sonnet-5-5
# DD_ORCHESTRATOR_EFFORT=high
# DD_ORCHESTRATOR_HISTORY=20
# DD_ORCHESTRATOR_MAX_DELEGATIONS=4
