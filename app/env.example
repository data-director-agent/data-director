# Copy to app/.env and run `uv run --env-file app/.env data-director`. app/.env is not committed.

# ANTHROPIC_API_KEY is read by the Anthropic SDK itself.
ANTHROPIC_API_KEY=

# A pydantic-ai model string. Default: anthropic:claude-sonnet-5 (needs ANTHROPIC_API_KEY).
# `test` selects pydantic-ai's offline test model. For a local model use ollama:<model>.
# DD_CHAT_MODEL=anthropic:claude-sonnet-5
# OLLAMA_BASE_URL=http://localhost:11434/v1
