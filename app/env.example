# Copy to app/.env and run `uv run --env-file app/.env data-director`. app/.env is not committed.

# The address the app serves on. Default: 127.0.0.1:7860.
# DD_APP_HOST=127.0.0.1
# DD_APP_PORT=7860
# Where the agents call the app back to delegate (ADR-0012), if not at DD_APP_HOST:DD_APP_PORT.
# DD_HARNESS_URL=http://127.0.0.1:7860

# Whom every run acts for, until there is authentication (ADR-0018). Required: the app does not
# start without them. This is the operator, not the person using the page.
DD_PRINCIPAL_ID=
DD_PRINCIPAL_NAME=
# DD_PRINCIPAL_KIND=person

# The deployment's configuration (ADR-0022). Each defaults to the app's reference set.
# DD_PROFILE=app/config/profile.yaml   # else app/config/profile.example.yaml
# DD_AGENTS_CONFIG=app/config/agents.yaml
# DD_SOURCES_CONFIG=app/config/sources.yaml
# DD_RUNS_DIR=app/runs
# DD_WRITE_CRATE=1

# The app runs no agent and holds no model key (ADR-0026, ADR-0027). Each agent service reads its
# own settings and key (workbench/agents/env.example), not this file.
