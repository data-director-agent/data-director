# Copy to app/.env and run `uv run --env-file app/.env data-director`. app/.env is not committed.

# ANTHROPIC_API_KEY is read by the Anthropic SDK itself.
ANTHROPIC_API_KEY=

# A pydantic-ai model string. Default: anthropic:claude-sonnet-5 (needs ANTHROPIC_API_KEY).
# `test` selects pydantic-ai's offline test model. For a local model use ollama:<model>.
# DD_CHAT_MODEL=anthropic:claude-sonnet-5
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Whom every run acts for, until there is authentication (ADR-0018). Required: the app does not
# start without them. This is the operator, not the person using the page.
DD_PRINCIPAL_ID=
DD_PRINCIPAL_NAME=
# DD_PRINCIPAL_KIND=person

# The deployment's configuration (ADR-0022). Each defaults to the app's reference set.
# DD_PROFILE=app/config/profile.yaml
# DD_AGENTS_CONFIG=app/config/agents.yaml
# DD_SOURCES_CONFIG=app/config/sources.yaml
# DD_RUNS_DIR=app/runs
# DD_WRITE_CRATE=1

# R3, which runs in the app's process, reads its own variables (agents/r3 factory.py).
# DD_R3_RETRIEVAL=snapshot
# DD_R3_EXPLAINER=template
