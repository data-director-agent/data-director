# The Data Director app's institutional profile: the reference set the app uses unless DD_PROFILE
# names another (docs/specs/policy-and-identity.md, docs/specs/system.md). Keys are as in workbench/profiles/README.md.
# TODO(#225): how a steward edits and reviews this profile in a deployment (#41).
profile_id: data-director-app
version: 10
description: Reference profile for the Data Director app; enables every in-tree agent, requires approval for writes.

agents:
  advisor.standards: advise
  advisor.policy: advise
  advisor.repository: advise
  example.hello: advise
  advisor.storage: advise
  advisor.quality: advise
  advisor.ethics: advise
  advisor.files: advise
  advisor.dmp: advise
  advisor.metadata: advise
  advisor.documentation: advise
  advisor.rights: advise
  advisor.linking: advise
  advisor.fairness: advise
  orchestrator.stub: advise
  orchestrator.model: advise

# The agent the home page converses with (docs/specs/app.md). The rule-based stub needs no model key.
# A deployment with a key names orchestrator.model instead, and raises `version`.
orchestrator: orchestrator.stub

# The classes of project content an agent whose card declares a hosted model may be given
# (docs/specs/projects.md, invariant 8). Without this key `inventory` and `decisions` may.
# `documentation` lets advisor.documentation write a project's documents with its hosted model;
# `decisions` are the facts people decided, such as which files go in, without which a drafter's
# run is refused once the project holds any.
hosted_models:
  - inventory
  - documentation
  - decisions

# Whether people may attach documents about their data to a project (docs/specs/projects.md).
# `refused` keeps none and gives no agent any document a project already holds.
attached_documents: allowed

# Whether people may use their own model account to pay for model calls
# (docs/specs/model-accounts.md). Off: the deployment pays for every call, as before.
model_accounts:
  own: off

# The APIs a person may deposit a draft through, after approving it, with their own repository
# account (docs/specs/deposit.md). They are used only where the deployment runs the deposit broker
# (DD_DEPOSIT_BROKER_URL); elsewhere every repository is deposited to by hand.
deposit_transports:
  - zenodo

# The institution's own repositories (institution_repositories) and storage (institution_storage),
# its administrators, its steward teams (stewardship) and who may sign in (access) are each
# instance's, so `apply` copies them from deployment.yaml (config/examples/deployment.yaml), not
# from this file. Steward teams: docs/guide/operations/configuration.md, "Data steward teams";
# access: the same guide, "Who may sign in". Without access, as here, anyone may sign in.

actions_requiring_approval:
  - deposit
  - metadata_write
