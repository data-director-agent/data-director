# The Data Director app's institutional profile: the reference set the app uses unless DD_PROFILE
# names another (docs/specs/policy-and-identity.md, docs/specs/system.md). Keys are as in workbench/profiles/README.md.
# TODO(#225): how a steward edits and reviews this profile in a deployment (#41).
profile_id: data-director-app
version: 9
description: Reference profile for the Data Director app; enables every in-tree agent, requires approval for writes.

agents:
  advisor.standards: advise
  advisor.policy: advise
  advisor.repository: advise
  example.hello: advise
  advisor.quality: advise
  advisor.ethics: advise
  advisor.files: advise
  advisor.dmp: advise
  advisor.metadata: advise
  advisor.documentation: advise
  advisor.rights: advise
  advisor.linking: advise
  advisor.fairness: advise
  orchestrator.stub: advise
  orchestrator.model: advise

# The agent the home page converses with (docs/specs/app.md). The rule-based stub needs no model key.
# A deployment with a key names orchestrator.model instead, and raises `version`.
orchestrator: orchestrator.stub

# The classes of project content an agent whose card declares a hosted model may be given
# (docs/specs/projects.md, invariant 8). Without this key only `inventory` may. `documentation`
# lets advisor.documentation write a project's documents with its hosted model.
hosted_models:
  - inventory
  - documentation

# Whether people may use their own model account to pay for model calls
# (docs/specs/model-accounts.md). Off: the deployment pays for every call, as before.
model_accounts:
  own: off

actions_requiring_approval:
  - deposit
  - metadata_write
