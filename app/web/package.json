{
  "name": "data-director-shell",
  "private": true,
  "version": "0.3.0-alpha.8",
  "description": "The Data Director app shell: drawn from each agent's manifest and the AG-UI event stream (docs/specs/app.md)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\" && npm run depcruise && npm run knip",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@data-director/agent-view": "file:../../sdk/browser",
    "@data-director/inventory": "file:../../inventory/browser",
    "@fontsource-variable/inter": "5.3.0",
    "@noble/hashes": "2.4.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "^18.7.2",
    "eslint": "10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest-axe": "11.0.0",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "minimatch": "^11.0.1",
    "zod": "4.6.7"
  }
}
