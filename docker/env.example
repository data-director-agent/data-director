# Copy to .env at the repository root (gitignored). Compose reads it for the variables below.
# `uv run scripts/dev.py setup` writes the same file, which scripts/dev.py start also reads.
# Every invocation acts for a named person, so these two are required.
DD_PRINCIPAL_ID=https://orcid.org/0000-0002-1825-0097
DD_PRINCIPAL_NAME=Josiah Carberry

# Optional: host ports, if the defaults (7860, 5173, 8000) are already in use.
# DD_APP_HOST_PORT=7860
# DD_WEB_HOST_PORT=5173
# DD_WORKBENCH_HOST_PORT=8000
